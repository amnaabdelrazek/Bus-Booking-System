@model Bus_Booking_System.ViewModel.RegisterVM

@{
    ViewData["Title"] = "Create Account";
}

<style>
    .register-wrapper {
        min-height: 90vh;
        display: flex;
        justify-content: center;
        align-items: center;
        padding: 40px 0;
    }

    .register-card {
        width: 100%;
        max-width: 550px;
        background: white;
        padding: 45px;
        border-radius: 24px;
        box-shadow: 0 20px 50px rgba(15, 23, 42, 0.08);
        border: none;
    }

    .form-label {
        font-weight: 700;
        color: #1e293b;
        font-size: 0.85rem;
        margin-bottom: 8px;
        display: block;
    }

    /* تحسين شكل الـ Input Groups */
    .input-group-custom {
        background-color: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        transition: all 0.3s ease;
        overflow: hidden;
    }

        .input-group-custom:focus-within {
            border-color: var(--primary-blue);
            box-shadow: 0 0 0 4px rgba(37, 99, 235, 0.1);
            background-color: #fff;
        }

        .input-group-custom .input-group-text {
            background: transparent;
            border: none;
            color: #94a3b8;
            padding-left: 15px;
        }

        .input-group-custom .form-control {
            background: transparent;
            border: none;
            padding: 12px 10px;
            font-size: 0.95rem;
        }

            .input-group-custom .form-control:focus {
                box-shadow: none;
            }

    /* Strength Meter */
    .strength-meter-container {
        height: 6px;
        background-color: #f1f5f9;
        border-radius: 10px;
        margin-top: 10px;
        overflow: hidden;
    }

    #strengthBar {
        height: 100%;
        width: 5%;
        transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        background-color: #e2e8f0;
    }

    .btn-register-submit {
        background-color: var(--primary-blue);
        color: white;
        border: none;
        padding: 14px;
        border-radius: 12px;
        font-weight: 700;
        transition: all 0.3s ease;
        margin-top: 10px;
    }

        .btn-register-submit:hover {
            background-color: var(--dark-blue);
            transform: translateY(-2px);
            box-shadow: 0 10px 20px rgba(37, 99, 235, 0.2);
            color: white;
        }

    .login-link {
        color: var(--primary-blue);
        text-decoration: none;
        font-weight: 700;
    }
</style>

<div class="register-wrapper">
    <div class="register-card">
        <div class="text-center mb-5">
            <div class="bg-primary bg-opacity-10 d-inline-block p-3 rounded-circle mb-3">
                <i class="bi bi-person-plus text-primary fs-2"></i>
            </div>
            <h2 class="fw-bold text-dark">Join BusBooking</h2>
            <p class="text-muted small">Create an account to manage your trips and bookings</p>
        </div>

        <form asp-action="Register" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger small mb-4 p-3 bg-danger bg-opacity-10 rounded-3"></div>

            <div class="row g-3">
                <div class="col-md-12">
                    <label asp-for="Fullname" class="form-label text-uppercase">Full Name</label>
                    <div class="input-group input-group-custom">
                        <span class="input-group-text"><i class="bi bi-person-badge"></i></span>
                        <input asp-for="Fullname" class="form-control" placeholder="John Doe" />
                    </div>
                    <span asp-validation-for="Fullname" class="text-danger small ms-1"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="UserName" class="form-label text-uppercase">Username</label>
                    <div class="input-group input-group-custom">
                        <span class="input-group-text"><i class="bi bi-at"></i></span>
                        <input asp-for="UserName" class="form-control" placeholder="johndoe88" />
                    </div>
                    <span asp-validation-for="UserName" class="text-danger small ms-1"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="Phone" class="form-label text-uppercase">Phone Number</label>
                    <div class="input-group input-group-custom" id="phoneGroup">
                        <span class="input-group-text"><i class="bi bi-phone"></i></span>
                        <input asp-for="Phone" id="Phone" class="form-control" placeholder="01xxxxxxxxx" />
                    </div>
                    <span asp-validation-for="Phone" class="text-danger small ms-1"></span>
                </div>

                <div class="col-md-12">
                    <label asp-for="Email" class="form-label text-uppercase">Email Address</label>
                    <div class="input-group input-group-custom">
                        <span class="input-group-text"><i class="bi bi-envelope"></i></span>
                        <input asp-for="Email" class="form-control" placeholder="name@company.com" />
                    </div>
                    <span asp-validation-for="Email" class="text-danger small ms-1"></span>
                </div>

                <div class="col-md-12">
                    <label asp-for="Password" class="form-label text-uppercase">Password</label>
                    <div class="input-group input-group-custom">
                        <span class="input-group-text"><i class="bi bi-shield-lock"></i></span>
                        <input asp-for="Password" type="password" id="passwordInput" class="form-control" placeholder="••••••••" />
                        <span class="input-group-text pe-3" onclick="togglePassword('passwordInput', 'eyeIcon')" style="cursor:pointer;">
                            <i class="bi bi-eye" id="eyeIcon"></i>
                        </span>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mt-2 px-1">
                        <span class="text-muted" style="font-size: 0.7rem;">STRENGTH: <span id="strengthText" class="fw-bold"></span></span>
                    </div>
                    <div class="strength-meter-container">
                        <div id="strengthBar"></div>
                    </div>
                    <span asp-validation-for="Password" class="text-danger small ms-1"></span>
                </div>

                <div class="col-md-12">
                    <label asp-for="ConfirmPassword" class="form-label text-uppercase">Confirm Password</label>
                    <div class="input-group input-group-custom" id="confirmPasswordGroup">
                        <span class="input-group-text"><i class="bi bi-shield-check"></i></span>
                        <input asp-for="ConfirmPassword" type="password" id="confirmPasswordInput" class="form-control" placeholder="••••••••" />
                        <span class="input-group-text pe-3" onclick="togglePassword('confirmPasswordInput', 'confirmEyeIcon')" style="cursor:pointer;">
                            <i class="bi bi-eye" id="confirmEyeIcon"></i>
                        </span>
                    </div>
                    <span asp-validation-for="ConfirmPassword" class="text-danger small ms-1"></span>
                </div>
            </div>

            <div class="my-4">
                <div class="form-check">
                    <input type="checkbox" class="form-check-input shadow-none" id="termsCheck" required />
                    <label class="form-check-label small text-muted ms-1" for="termsCheck">
                        I agree to the <a href="#" class="login-link">Terms of Service</a>
                    </label>
                </div>
            </div>

            <button type="submit" class="btn btn-register-submit w-100 shadow-sm">
                <i class="bi bi-person-plus-fill me-2"></i> Create Account
            </button>

            <div class="text-center mt-4">
                <p class="text-muted small mb-0">Already a member? <a asp-action="Login" class="login-link">Sign in</a></p>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        const passwordInput = document.getElementById("passwordInput");
        const confirmPasswordInput = document.getElementById("confirmPasswordInput");
        const phoneInput = document.getElementById("Phone");

        function togglePassword(inputId, iconId) {
            const input = document.getElementById(inputId);
            const icon = document.getElementById(iconId);
            if (input.type === "password") {
                input.type = "text";
                icon.classList.replace("bi-eye", "bi-eye-slash");
            } else {
                input.type = "password";
                icon.classList.replace("bi-eye-slash", "bi-eye");
            }
        }

        passwordInput.addEventListener("input", function () {
            const val = passwordInput.value;
            let strength = 0;
            if (val.length >= 6) strength++;
            if (/[A-Z]/.test(val)) strength++;
            if (/[0-9]/.test(val)) strength++;
            if (/[^A-Za-z0-9]/.test(val)) strength++;

            const bar = document.getElementById("strengthBar");
            const text = document.getElementById("strengthText");

            const levels = [
                { width: "5%", color: "#f1f5f9", label: "" },
                { width: "25%", color: "#ef4444", label: "WEAK" },
                { width: "50%", color: "#f59e0b", label: "FAIR" },
                { width: "75%", color: "#3b82f6", label: "GOOD" },
                { width: "100%", color: "#10b981", label: "STRONG" }
            ];

            const current = levels[strength];
            bar.style.width = current.width;
            bar.style.backgroundColor = current.color;
            text.innerText = current.label;
            text.style.color = current.color;
        });

        phoneInput.addEventListener("input", function () {
            const regex = /^01[0-2,5]{1}[0-9]{8}$/;
            const group = document.getElementById('phoneGroup');
            if (phoneInput.value.length > 0) {
                group.style.borderColor = regex.test(phoneInput.value) ? "#10b981" : "#ef4444";
            } else {
                group.style.borderColor = "#e2e8f0";
            }
        });

        confirmPasswordInput.addEventListener("input", function () {
            const group = document.getElementById('confirmPasswordGroup');
            if (confirmPasswordInput.value.length > 0) {
                group.style.borderColor = (confirmPasswordInput.value === passwordInput.value) ? "#10b981" : "#ef4444";
            }
        });
    </script>
}