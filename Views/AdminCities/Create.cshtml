@model Bus_Booking_System.Models.City
@{
    ViewData["Title"] = "Add New City";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<style>
    :root {
        --primary-blue: #0056b3;
        --dark-blue: #0d2b4d;
    }

    .custom-card {
        background: #ffffff;
        border-radius: 16px;
        border: none;
        box-shadow: 0 8px 24px rgba(13, 43, 77, 0.08);
    }

    .btn-primary-custom {
        background-color: var(--primary-blue);
        color: white;
        border: none;
        border-radius: 8px;
        padding: 10px 24px;
        font-weight: 600;
        transition: all 0.3s ease;
    }

        .btn-primary-custom:hover {
            background-color: var(--dark-blue);
            transform: translateY(-2px);
            color: white;
        }
</style>

<div class="container py-5 d-flex justify-content-center">
    <div class="custom-card w-100 p-0 overflow-hidden" style="max-width: 600px;">
        <div class="p-4 border-bottom text-center" style="background-color: var(--dark-blue); color: white;">
            <i class="bi bi-plus-circle display-6 mb-2 d-block text-white opacity-75"></i>
            <h4 class="fw-bold mb-0">Add New City</h4>
        </div>

        <div class="card-body p-4 p-md-5">
            <form asp-action="Create">
                <div class="mb-4">
                    <label asp-for="Name" class="form-label fw-bold text-muted small text-uppercase">City Name</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0"><i class="bi bi-geo-alt text-muted"></i></span>
                        <input asp-for="Name" class="form-control border-start-0 ps-0" placeholder="e.g. Cairo, Alexandria..." style="height: 45px;" />
                    </div>
                    <span asp-validation-for="Name" class="text-danger small mt-1 d-block"></span>
                </div>

                <div class="d-flex gap-3 pt-3 border-top">
                    <a asp-action="Index" class="btn btn-light fw-bold w-50 py-2" style="border-radius: 8px; color: #6c757d;">Cancel</a>
                    <button type="submit" class="btn btn-primary-custom w-50 py-2"><i class="bi bi-save me-2"></i>Save City</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}