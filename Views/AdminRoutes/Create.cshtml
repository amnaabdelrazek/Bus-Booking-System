@model Bus_Booking_System.ViewModel.RouteVM
@{
    ViewData["Title"] = "Add New Route";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="card border-0 shadow-sm rounded-3" style="max-width: 700px;">
    <div class="card-header bg-white border-bottom-0 pt-4 pb-0">
        <h4 class="fw-bold text-muted">Route Specifications</h4>
    </div>
    <div class="card-body p-4">
        <form asp-action="Create">
            <div class="row mb-4">
                <div class="col-md-5">
                    <label asp-for="OriginCityId" class="form-label fw-bold">Origin City</label>
                    <select asp-for="OriginCityId" asp-items="Model.CitiesList" class="form-select">
                        <option value="">-- Select Origin --</option>
                    </select>
                    <span asp-validation-for="OriginCityId" class="text-danger small"></span>
                </div>
                <div class="col-md-2 d-flex align-items-center justify-content-center pt-3">
                    <i class="bi bi-arrow-right-circle fs-3 text-muted"></i>
                </div>
                <div class="col-md-5">
                    <label asp-for="DestinationCityId" class="form-label fw-bold">Destination City</label>
                    <select asp-for="DestinationCityId" asp-items="Model.CitiesList" class="form-select">
                        <option value="">-- Select Destination --</option>
                    </select>
                    <span asp-validation-for="DestinationCityId" class="text-danger small"></span>
                </div>
            </div>

            <div class="row mb-4">
                <div class="col-md-4">
                    <label asp-for="Distance" class="form-label fw-bold">Distance (km)</label>
                    <input asp-for="Distance" class="form-control" type="number" step="0.1" />
                    <span asp-validation-for="Distance" class="text-danger small"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="TimeNeeded" class="form-label fw-bold">Est. Time</label>
                    <input asp-for="TimeNeeded" class="form-control" type="time" />
                    <span asp-validation-for="TimeNeeded" class="text-danger small"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="Price" class="form-label fw-bold">Base Price ($)</label>
                    <input asp-for="Price" class="form-control" type="number" step="0.01" />
                    <span asp-validation-for="Price" class="text-danger small"></span>
                </div>
            </div>

            <div class="d-flex justify-content-between">
                <a asp-action="Index" class="btn btn-light">Cancel</a>
                <button type="submit" class="btn btn-primary">Save Route</button>
            </div>
        </form>
    </div>
</div>
@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

}