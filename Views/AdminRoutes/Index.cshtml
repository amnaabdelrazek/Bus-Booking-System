@model IEnumerable<Bus_Booking_System.Models.BusRoute>
@{
    ViewData["Title"] = "Manage Routes";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h3 class="fw-bold text-muted"><i class="bi bi-signpost-split me-2"></i>Travel Routes</h3>
    <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg me-1"></i> Add New Route</a>
</div>

@if (TempData["SuccessMsg"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle me-2"></i> @TempData["SuccessMsg"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="card border-0 shadow-sm rounded-3">
    <div class="card-body p-0">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th class="ps-4">Route Path</th>
                    <th>Distance</th>
                    <th>Est. Time</th>
                    <th>Base Price</th>
                    <th class="text-end pe-4">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="ps-4 fw-bold">
                            <span class="text-primary">@item.OriginCity.Name</span> 
                            <i class="bi bi-arrow-right mx-2 text-muted"></i> 
                            <span class="text-success">@item.DestinationCity.Name</span>
                        </td>
                        <td>@item.Distance <small class="text-muted">km</small></td>
                        <td><i class="bi bi-clock text-muted me-1"></i> @item.TimeNeeded.ToString(@"hh\:mm")</td>
                        <td class="fw-bold">$@item.Price</td>
                        <td class="text-end pe-4">
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary me-1"><i class="bi bi-pencil"></i></a>
                            <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this route?');">
                                <button type="submit" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                            </form>
                        </td>
                    </tr>
                }
                @if(!Model.Any())
                {
                    <tr><td colspan="5" class="text-center py-4 text-muted">No routes configured yet.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div> >