@model Bus_Booking_System.ViewModel.TripVM
@{
    ViewData["Title"] = "Edit Trip";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="card border-0 shadow-sm rounded-3" style="max-width: 800px;">
    <div class="card-header bg-white border-bottom-0 pt-4 pb-0">
        <h4 class="fw-bold text-muted"><i class="bi bi-pencil-square me-2"></i>Edit Scheduled Trip</h4>
        <div class="alert alert-warning mt-2 py-2 small">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> <strong>Warning:</strong> Changing the Bus or Route for a trip that already has bookings may cause data errors.
        </div>
    </div>
    <div class="card-body p-4">
        <form asp-action="Edit">
            <input type="hidden" asp-for="Id" />

            <div class="row mb-4">
                <div class="col-md-7">
                    <label asp-for="BusRouteId" class="form-label fw-bold">Travel Route</label>
                    <select asp-for="BusRouteId" asp-items="Model.RoutesList" class="form-select"></select>
                    <span asp-validation-for="BusRouteId" class="text-danger small"></span>
                </div>
                <div class="col-md-5">
                    <label asp-for="BusId" class="form-label fw-bold">Assigned Bus</label>
                    <select asp-for="BusId" asp-items="Model.BusesList" class="form-select"></select>
                    <span asp-validation-for="BusId" class="text-danger small"></span>
                </div>
            </div>

            <div class="row mb-4">
                <div class="col-md-4">
                    <label asp-for="TravelDate" class="form-label fw-bold">Travel Date</label>
                    <input asp-for="TravelDate" class="form-control" type="date" />
                    <span asp-validation-for="TravelDate" class="text-danger small"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="DepartureTime" class="form-label fw-bold">Departure Time</label>
                    <input asp-for="DepartureTime" class="form-control" type="time" />
                    <span asp-validation-for="DepartureTime" class="text-danger small"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="ArrivalTime" class="form-label fw-bold">Arrival Time</label>
                    <input asp-for="ArrivalTime" class="form-control" type="time" />
                    <span asp-validation-for="ArrivalTime" class="text-danger small"></span>
                </div>
            </div>

            <div class="mb-4">
                <label asp-for="Status" class="form-label fw-bold">Trip Status</label>
                <select asp-for="Status" class="form-select fw-bold" style="max-width: 250px;">
                    <option value="0" class="text-success">Open For Booking</option>
                    <option value="1" class="text-danger">Cancelled</option>
                    <option value="2" class="text-secondary">Completed</option>
                </select>
                <span asp-validation-for="Status" class="text-danger small"></span>
            </div>

            <div class="d-flex justify-content-between border-top pt-4">
                <a asp-action="Index" class="btn btn-light">Cancel</a>
                <button type="submit" class="btn btn-primary"><i class="bi bi-save me-2"></i>Save Changes</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

}