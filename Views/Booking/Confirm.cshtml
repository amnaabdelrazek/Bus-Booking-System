@model Bus_Booking_System.ViewModel.ConfirmBookingVM

<div class="container my-5">
    <div class="card shadow border-0 mx-auto" style="max-width: 500px; border-radius: 20px;">
        <div class="card-body p-4">
            <h4 class="fw-bold mb-4">Confirm Your Booking</h4>
            <div class="bg-light p-3 rounded mb-3">
                <p class="mb-1 text-muted">Selected Seats</p>
                <div class="h5 fw-bold">@string.Join(", ", Model.SeatIds)</div>
            </div>
            <div class="d-flex justify-content-between mb-4">
                <span>Total Amount:</span>
                <span class="h4 fw-bold text-primary">$@Model.TotalPrice</span>
            </div>

            <form asp-action="Confirm" method="post">
                <input type="hidden" asp-for="TripId" />
                <input type="hidden" asp-for="PricePerSeat" />
                @for (int i = 0; i < Model.SeatIds.Count; i++)
                {
                    <input type="hidden" name="SeatIds[@i]" value="@Model.SeatIds[i]" />
                }
                <button type="submit" class="btn btn-dark w-100 py-3 fw-bold" style="border-radius:12px;">
                    Confirm & Proceed &rarr;
                </button>
            </form>
            <a href="javascript:history.back()" class="btn btn-link w-100 mt-2 text-muted text-decoration-none">Back to seats</a>
        </div>
    </div>
</div>