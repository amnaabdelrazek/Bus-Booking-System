@model List<Bus_Booking_System.ViewModel.BookingDeatailsVM>

@{
    ViewData["Title"] = "My Bookings";
}

<style>
    :root {
        --primary-blue: #0d6efd;
        --soft-gray: #f1f5f9;
        --dark-navy: #1e293b;
    }

    .booking-card {
        border: none;
        border-radius: 20px;
        transition: all 0.3s ease;
        background: #fff;
        border-left: 5px solid var(--primary-blue);
    }

        .booking-card:hover {
            transform: scale(1.02);
            box-shadow: 0 15px 30px rgba(0,0,0,0.1) !important;
        }

        .booking-card.cancelled {
            border-left-color: #ef4444;
            opacity: 0.8;
        }

    .ticket-header {
        background: #fafafa;
        padding: 15px 20px;
        border-bottom: 1px dashed #e2e8f0;
    }

    .route-text {
        font-size: 1.1rem;
        color: var(--dark-navy);
        letter-spacing: -0.5px;
    }

    .info-label {
        font-size: 0.75rem;
        color: #94a3b8;
        text-transform: uppercase;
        font-weight: 700;
        margin-bottom: 2px;
    }

    .info-value {
        font-size: 0.9rem;
        color: var(--dark-navy);
        font-weight: 600;
    }

    .btn-cancel-ticket {
        border: 1px solid #fee2e2;
        color: #ef4444;
        background: #fef2f2;
        transition: all 0.2s;
    }

        .btn-cancel-ticket:hover {
            background: #ef4444;
            color: #fff;
        }
</style>

<div class="container my-5">
    <div class="d-flex justify-content-between align-items-end mb-5">
        <div>
            <span class="badge bg-primary-subtle text-primary mb-2 px-3 py-2 rounded-pill">Travel Center</span>
            <h2 class="fw-bold m-0" style="color: var(--dark-navy);">My Bookings</h2>
            <p class="text-muted m-0">Track and manage your upcoming journeys</p>
        </div>
        <a asp-controller="Trip" asp-action="Index" class="btn btn-dark rounded-pill px-4">
            <i class="bi bi-plus-lg me-1"></i> New Booking
        </a>
    </div>

    <div class="row" id="bookings-container">
        @if (!Model.Any())
        {
            <div class="col-12 text-center py-5">
                <div class="bg-white rounded-5 p-5 shadow-sm border border-dashed">
                    <img src="https://illustrations.popsy.co/gray/home-office.svg" style="width: 180px;" alt="Empty">
                    <h4 class="text-dark mt-4 fw-bold">No Bookings Found</h4>
                    <p class="text-muted mb-4">You haven't planned any trips yet. Ready to explore?</p>
                    <a asp-controller="Trip" asp-action="Index" class="btn btn-primary px-5 py-2 rounded-pill shadow">Start Booking</a>
                </div>
            </div>
        }
        else
        {
            @foreach (var item in Model)
            {
                bool isCancelled = item.Status == "Cancelled";

                <div class="col-md-6 col-lg-4 mb-4" id="booking-card-@item.BookingId">
                    <div class="card booking-card h-100 shadow-sm @(isCancelled ? "cancelled" : "")">
                        <div class="ticket-header d-flex justify-content-between align-items-center">
                            <span class="small fw-bold text-muted"><i class="bi bi-qr-code me-1"></i> #@item.BookingId</span>
                            <span class="h6 m-0 fw-bold text-primary">@item.TotalPrice EGP</span>
                        </div>

                        <div class="card-body p-4">
                            <div class="mb-4">
                                <div class="info-label">Route</div>
                                <div class="route-text fw-bold">@item.Route</div>
                                <div class="mt-2">
                                    <span class="status-badge badge @(isCancelled ? "bg-danger-subtle text-danger" : "bg-success-subtle text-success") rounded-pill px-3">
                                        <i class="status-icon bi @(isCancelled ? "bi-x-circle" : "bi-check-circle") me-1"></i>
                                        <span class="status-text">@item.Status</span>
                                    </span>
                                </div>
                            </div>

                            <div class="row g-3 mb-4">
                                <div class="col-6">
                                    <div class="info-label">Date</div>
                                    <div class="info-value"><i class="bi bi-calendar3 me-1"></i> @item.Date</div>
                                </div>
                                <div class="col-6 text-end">
                                    <div class="info-label">Time</div>
                                    <div class="info-value"><i class="bi bi-clock me-1"></i> @item.Time</div>
                                </div>
                                <div class="col-12">
                                    <div class="info-label">Seats Assigned</div>
                                    <div class="info-value text-primary">
                                        <i class="bi bi-layers me-1"></i> @string.Join(", ", item.SeatNumbers)
                                    </div>
                                </div>
                            </div>

                            <div class="action-btn-container">
                                @if (!isCancelled)
                                {
                                    <button onclick="confirmCancel(@item.BookingId)" class="btn btn-cancel-ticket w-100 rounded-pill py-2 fw-bold">
                                        Cancel This Trip
                                    </button>
                                }
                                else
                                {
                                    <button class="btn btn-secondary disabled w-100 rounded-pill py-2 fw-bold opacity-50">
                                        Booking Cancelled
                                    </button>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/6.0.1/signalr.min.js"></script>

    <script>
        const connection = new signalR.HubConnectionBuilder()
            .withUrl("/bookingHub")
            .withAutomaticReconnect()
            .build();

        // وظيفة موحدة لتحديث واجهة الكارت (Card UI)
        function updateBookingCardToCancelled(bookingId) {
            const card = document.getElementById(`booking-card-${bookingId}`);
            if (card) {
                // 1. إضافة كلاس الإلغاء للكارت (لتغيير لون الحافة والشفافية)
                const cardInner = card.querySelector('.booking-card');
                if (cardInner) cardInner.classList.add('cancelled');

                // 2. تحديث نص وألوان الـ Badge
                const statusBadge = card.querySelector('.status-badge');
                const statusText = card.querySelector('.status-text');
                const statusIcon = card.querySelector('.status-icon');

                if (statusBadge) {
                    statusBadge.classList.remove('bg-success-subtle', 'text-success');
                    statusBadge.classList.add('bg-danger-subtle', 'text-danger');
                }
                if (statusText) statusText.innerText = "Cancelled";
                if (statusIcon) {
                    statusIcon.classList.remove('bi-check-circle');
                    statusIcon.classList.add('bi-x-circle');
                }

                // 3. تغيير الزر ليصبح "Booking Cancelled" وغير مفعل
                const actionContainer = card.querySelector('.action-btn-container');
                if (actionContainer) {
                    actionContainer.innerHTML = '<button class="btn btn-secondary disabled w-100 rounded-pill py-2 fw-bold opacity-50">Booking Cancelled</button>';
                }
            }
        }

        // تحديث الواجهة عند استلام إشعار إلغاء عبر SignalR (للمتصفحات الأخرى المفتوحة لنفس اليوزر)
        connection.on("ReceiveCancellation", function (bookingId) {
            updateBookingCardToCancelled(bookingId);
        });

        connection.start().catch(err => console.error(err.toString()));

        function confirmCancel(id) {
            Swal.fire({
                title: 'Are you sure?',
                text: "You are about to cancel this booking. This action cannot be undone!",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#ef4444',
                cancelButtonColor: '#64748b',
                confirmButtonText: 'Yes, cancel it!',
                cancelButtonText: 'No, keep it',
                customClass: {
                    popup: 'rounded-4',
                    confirmButton: 'rounded-pill px-4',
                    cancelButton: 'rounded-pill px-4'
                }
            }).then((result) => {
                if (result.isConfirmed) {
                    Swal.showLoading();

                    $.post('/Booking/CancelBooking', { BookingId: id })
                        .done(function () {
                            // التعديل هنا: تحديث الواجهة فوراً عند نجاح الطلب
                            updateBookingCardToCancelled(id);

                            Swal.fire({
                                title: 'Success!',
                                text: 'The trip has been cancelled.',
                                icon: 'success',
                                confirmButtonColor: '#0d6efd',
                                timer: 2000,
                                showConfirmButton: false
                            });
                        })
                        .fail(function () {
                            Swal.fire('Error!', 'Something went wrong. Please try again.', 'error');
                        });
                }
            })
        }
    </script>
}