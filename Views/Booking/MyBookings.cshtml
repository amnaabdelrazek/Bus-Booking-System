@model List<Bus_Booking_System.ViewModel.BookingDeatailsVM>

@{
    ViewData["Title"] = "My Bookings";
}

<div class="container my-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold" style="color: var(--dark-blue);">My Bookings</h2>
            <p class="text-muted small">Manage your upcoming and past trips</p>
        </div>
    </div>

    <div class="row" id="bookings-container">
        @if (!Model.Any())
        {
            <div class="col-12 text-center py-5 custom-card">
                <i class="bi bi-ticket-perforated text-muted" style="font-size: 4rem;"></i>
                <h4 class="text-muted mt-3 fw-bold">You don't have any bookings yet.</h4>
                <a asp-controller="Trip" asp-action="Index" class="btn btn-primary-custom mt-3 text-white">Book a Trip Now</a>
            </div>
        }
        else
        {
            @foreach (var item in Model)
            {
                <div class="col-md-6 col-lg-4 mb-4" id="booking-card-@item.BookingId">
                    <div class="card custom-card h-100 p-0 overflow-hidden shadow-sm">
                        <div class="bg-light p-3 border-bottom d-flex justify-content-between align-items-center">
                            <span class="badge bg-dark rounded-pill px-3 py-2"><i class="bi bi-hash"></i> @item.BookingId</span>
                            <span class="fw-bold text-primary">@item.TotalPrice EGP</span>
                        </div>

                        <div class="card-body p-4">
                            <div class="mb-3">
                                <h5 class="fw-bold text-dark d-flex align-items-center">
                                    <i class="bi bi-geo-alt-fill text-primary me-2"></i> @item.Route
                                </h5>
                                <span class="badge @(item.Status == "Cancelled" ? "bg-danger" : "bg-success") small">@item.Status</span>
                            </div>

                            <ul class="list-unstyled text-muted small mb-4">
                                <li class="mb-2">
                                    <i class="bi bi-calendar-event me-2"></i> Date: <strong class="text-dark">@item.Date</strong>
                                </li>
                                <li class="mb-2">
                                    <i class="bi bi-clock me-2"></i> Time: <strong class="text-dark">@item.Time</strong>
                                </li>
                                <li class="mb-2">
                                    <i class="bi bi-person-fill me-2"></i> Seats:
                                    <strong class="text-dark">
                                        @string.Join(", ", item.SeatNumbers)
                                    </strong>
                                </li>
                            </ul>

                            <div class="action-btn-container text-center">
                                @if (item.Status != "Cancelled")
                                {
                                    <button onclick="confirmCancel(@item.BookingId)" class="btn btn-outline-danger w-100 rounded-pill">
                                        <i class="bi bi-x-circle me-1"></i> Cancel Booking
                                    </button>
                                }
                                else
                                {
                                    <span class="badge bg-danger p-2 w-100 rounded-pill">Cancelled</span>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/6.0.1/signalr.min.js"></script>

    <script>
        const connection = new signalR.HubConnectionBuilder().withUrl("/bookingHub").build();

        connection.on("ReceiveCancellation", function (bookingId) {
            const card = document.getElementById(`booking-card-${bookingId}`);
            if (card) {
                card.style.opacity = '0.5';
                const actionContainer = card.querySelector('.action-btn-container');
                if (actionContainer) {
                    actionContainer.innerHTML = '<span class="badge bg-danger p-2 w-100 rounded-pill">Cancelled</span>';
                }
            }
        });

        connection.start().catch(err => console.error(err.toString()));

        function confirmCancel(id) {
            Swal.fire({
                title: 'Cancel Booking?',
                text: "Are you sure you want to cancel this trip?",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#0056b3',
                cancelButtonColor: '#dc3545',
                confirmButtonText: 'Yes, Cancel it',
                cancelButtonText: 'No, Keep it',
                background: '#ffffff',
                borderRadius: '16px'
            }).then((result) => {
                if (result.isConfirmed) {
                    $.post('/Booking/CancelBooking', { BookingId: id })
                        .done(function () {
                            Swal.fire({
                                title: 'Cancelled!',
                                text: 'Your booking has been cancelled successfully.',
                                icon: 'success',
                                confirmButtonColor: '#0056b3'
                            }).then(() => {
                                // تحديث الحالة في الصفحة فوراً بدون ريلود لو مش مستخدمة SignalR للكل
                                location.reload();
                            });
                        })
                        .fail(function () {
                            Swal.fire('Error!', 'Could not cancel booking. Try again.', 'error');
                        });
                }
            })
        }
    </script>
}