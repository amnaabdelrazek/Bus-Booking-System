@model List<Bus_Booking_System.ViewModel.BookingDeatailsVM>

@{
    ViewData["Title"] = "My Bookings";
}

<div class="container my-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">My Bookings</h2>
            <p class="text-muted small">Manage your upcoming and past trips</p>
        </div>
    </div>

    <div class="row" id="bookings-container">
        @if (!Model.Any())
        {
            <div class="col-12 text-center py-5">
                <i class="bi bi-ticket-perforated text-muted display-1"></i>
                <h5 class="text-muted mt-3">You don't have any bookings yet.</h5>
                <a asp-controller="Trip" asp-action="Index" class="btn btn-dark mt-3">Book a Trip Now</a>
            </div>
        }
        else
        {
            @foreach (var item in Model)
            {
                <div class="col-12 mb-3" id="booking-card-@item.BookingId">
                    <div class="card border-0 shadow-sm p-3 h-booking-card" style="border-radius:20px;">
                        <div class="card-body p-2">
                            <div class="row align-items-center">
                                <div class="col-md-7">
                                    <div class="d-flex align-items-center">
                                        <div class="icon-box bg-primary-subtle text-primary me-3">
                                            <i class="bi bi-bus-front-fill fs-4"></i>
                                        </div>
                                        <div>
                                            <h5 class="fw-bold mb-1">@item.Route</h5>
                                            <div class="text-muted small">
                                                <span class="me-3"><i class="bi bi-calendar3 me-1"></i> @item.Date</span>
                                                <span class="me-3"><i class="bi bi-clock me-1"></i> @item.Time</span>
                                                <span><i class="bi bi-armchair-fill me-1"></i> Seats: <strong>@string.Join(", ", item.SeatNumbers)</strong></span>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-md-3 text-md-center my-3 my-md-0">
                                    <div class="fw-bold fs-5 mb-1">$@item.TotalPrice</div>
                                    <span id="status-badge-@item.BookingId" class="badge rounded-pill px-3 py-2 @(item.Status == "Confirmed" ? "bg-success-subtle text-success" : "bg-danger-subtle text-danger")">
                                        @item.Status
                                    </span>
                                </div>

                                <div class="col-md-2 text-end" id="action-container-@item.BookingId">
                                    @if (item.Status == "Confirmed")
                                    {
                                        <button class="btn btn-outline-danger border-2 fw-bold w-100"
                                                style="border-radius:12px;"
                                                onclick="confirmCancel(@item.BookingId)">
                                            Cancel
                                        </button>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
    </div>
</div>

<style>
    .h-booking-card {
        transition: transform 0.2s, box-shadow 0.2s;
    }

        .h-booking-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(0,0,0,0.06) !important;
        }

    .icon-box {
        width: 50px;
        height: 50px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 15px;
    }

    .bg-success-subtle {
        background-color: #d1e7dd;
        color: #0f5132;
    }

    .bg-danger-subtle {
        background-color: #f8d7da;
        color: #842029;
    }

    .bg-primary-subtle {
        background-color: #cfe2ff;
        color: #084298;
    }
</style>
<script src="~/lib/jquery/dist/jquery.js"></script>
<script src="~/lib/microsoft-signalr/signalr.min.js"></script>

@section Scripts{
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        const connection = new signalR.HubConnectionBuilder()
            .withUrl("/bookingHub")
            .build();

            connection.on("BookingCancelled",function(bookingId)
            {
                const badge = document.getElementById(`status-badge-${bookingId}`);
                const actionContainer = document.getElementById(`action-container-${bookingId}`);

                if(badge)
                {
                    badge.className = "badge rounded-pill px-3 py-2 bg-danger-subtle text-danger";
                    badge.innerText = "Cancelled";
                }

                if (actionContainer) {
                actionContainer.innerHTML = ''; 
                }
            });
            connection.start().catch(err => console.error(err.toString()));

            function confirmCancel(id) {
            Swal.fire({
                title: 'Cancel Booking?',
                text: "Are you sure you want to cancel this trip?",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#212529',
                cancelButtonColor: '#fb3a3a',
                confirmButtonText: 'Yes, Cancel it',
                cancelButtonText: 'No, Keep it',
                border: 'none',
                borderRadius: '20px'
            }).then((result) => {
                if (result.isConfirmed) {
                    
                    $.post('/Booking/CancelBooking', { BookingId: id })
                    .done(function() {
                        Swal.fire({
                            title: 'Cancelled!',
                            text: 'Your booking has been cancelled successfully.',
                            icon: 'success',
                            confirmButtonColor: '#212529'
                        });
                    })
                    .fail(function() {
                        Swal.fire('Error!', 'Could not cancel booking. Try again.', 'error');
                    });
                }
            })
        }
    </script>

}
