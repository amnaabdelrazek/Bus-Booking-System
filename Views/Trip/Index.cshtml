@model Bus_Booking_System.ViewModel.TripIndexVM
@{
    ViewData["Title"] = "Trips";
}

<style>
    /* تحسين الفلتر الجانبي */
    .filter-card {
        background: #ffffff;
        border-radius: 24px;
        border: none;
        box-shadow: 0 10px 30px rgba(15, 23, 42, 0.06);
        position: sticky;
        top: 100px;
    }

    .filter-label {
        color: #64748b;
        font-size: 0.75rem;
        letter-spacing: 1px;
        font-weight: 800;
        text-transform: uppercase;
        margin-bottom: 10px;
        display: block;
    }

    /* تحسين الـ Range Input */
    .custom-range::-webkit-slider-thumb {
        background: var(--primary-blue);
        border: 3px solid #fff;
        box-shadow: 0 4px 10px rgba(37, 99, 235, 0.3);
        height: 20px;
        width: 20px;
    }

    .form-control-light {
        background-color: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        padding: 10px 15px;
        transition: all 0.3s;
    }

        .form-control-light:focus {
            background-color: #fff;
            border-color: var(--primary-blue);
            box-shadow: 0 0 0 4px rgba(37, 99, 235, 0.1);
        }

    /* تأثيرات البطاقات */
    .trips-container {
        min-height: 600px;
    }

    .badge-status {
        padding: 6px 12px;
        border-radius: 8px;
        font-weight: 700;
        font-size: 0.7rem;
        text-transform: uppercase;
    }
</style>

<div class="container py-5">
    <div class="row align-items-end mb-5">
        <div class="col-md-8 text-center text-md-start">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-2">
                    <li class="breadcrumb-item"><a href="/" class="text-decoration-none">Home</a></li>
                    <li class="breadcrumb-item active">Trips</li>
                </ol>
            </nav>
            <h2 class="fw-bold text-dark display-6">Explore <span class="text-primary text-gradient">Trips</span></h2>
            <p class="text-muted mb-0" id="TripsCountText">
                <i class="bi bi-bus-front me-2"></i>@Model.Trips.Count journeys available for you
            </p>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-lg-3">
            <div class="filter-card p-4">
                <h5 class="fw-bold mb-4 d-flex align-items-center text-dark">
                    <i class="bi bi-funnel me-2 text-primary"></i> Refine Search
                </h5>

                <form asp-action="Index" method="get">
                    <div class="mb-4">
                        <label class="filter-label">Travel Date</label>
                        <input type="date" name="travelDate" class="form-control form-control-light"
                               value="@Model.FilterDate?.ToString("yyyy-MM-dd")">
                    </div>

                    <div class="mb-4">
                        <label class="filter-label">Trip Status</label>
                        <select name="status" class="form-select form-control-light">
                            <option value="">All Statuses</option>
                            <option value="OpenForBooking">Open For Booking</option>
                            <option value="Cancelled">Cancelled</option>
                            <option value="Completed">Completed</option>
                        </select>
                    </div>

                    <div class="mb-4">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <label class="filter-label mb-0">Max Price</label>
                            <span class="badge bg-primary bg-opacity-10 text-primary fw-bold">
                                <span id="priceValue">@Model.FilterMaxPrice</span> EGP
                            </span>
                        </div>
                        <input type="range" name="maxPrice" class="form-range custom-range"
                               min="@Model.MinPrice" max="@Model.MaxPrice" step="10"
                               value="@Model.FilterMaxPrice"
                               oninput="document.getElementById('priceValue').innerText = this.value" />
                        <div class="d-flex justify-content-between mt-1 text-muted small fw-bold">
                            <span>@Model.MinPrice</span>
                            <span>@Model.MaxPrice</span>
                        </div>
                    </div>

                    <button type="submit" class="btn btn-primary w-100 py-3 fw-bold rounded-3 shadow-sm mb-3">
                        <i class="bi bi-search me-2"></i> Apply Filters
                    </button>

                    <a asp-action="Index" class="btn btn-link w-100 text-decoration-none text-muted small fw-bold">
                        Reset All Filters
                    </a>
                </form>
            </div>
        </div>

        <div class="col-lg-9">
            <div class="trips-container" id="TripsCardsContainer">
                <partial name="_TripsCardsPartial" model="Model" />
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/lib/jquery/dist/jquery.js"></script>
    <script src="~/lib/microsoft-signalr/signalr.min.js"></script>
    <script>
        // إعداد اتصال SignalR
        var connection = new signalR.HubConnectionBuilder()
            .withUrl("/bookingHub")
            .withAutomaticReconnect() // إضافة ميزة إعادة الاتصال التلقائي
            .build();

        connection.on("UpdateSeatStatus", function (tripId, seatIds, status, isFull) {
            var seatsElement = document.getElementById("seats-count-" + tripId);
            if (seatsElement) {
                var currentCount = parseInt(seatsElement.innerText);
                var numberOfSeats = Array.isArray(seatIds) ? seatIds.length : 1;
                var newCount = (status === "Booked") ? Math.max(0, currentCount - numberOfSeats) : currentCount + numberOfSeats;

                // تحديث النص مع إضافة أنيميشن بسيط للتنبيه
                seatsElement.innerText = newCount;

                var parentWrapper = seatsElement.closest('.seats-badge-wrapper');
                if (newCount < 5) {
                    parentWrapper.classList.add("text-danger", "animate__animated", "animate__shakeX");
                } else {
                    parentWrapper.classList.remove("text-danger");
                }

                if (isFull || newCount <= 0) {
                    setTimeout(() => { loadTripsPartial(); }, 1000); // تحديث القائمة بالكامل إذا امتلأ الباص
                }
            }
        });

        connection.on("ReceiveTripsUpdate", function () {
            loadTripsPartial();
        });

        function loadTripsPartial() {
            var partialUrl = '@Url.Action("GetTripsPartial", "Trip")' + window.location.search;
            $("#TripsCardsContainer").fadeOut(200, function () {
                $(this).load(partialUrl, function () {
                    $(this).fadeIn(200);
                    updateTripsCount();
                });
            });
        }

        function updateTripsCount() {
            var tripsCount = $("#TripsCountValue").val();
            if (tripsCount != undefined) {
                $("#TripsCountText").html('<i class="bi bi-bus-front me-2"></i>' + tripsCount + ' journeys available for you');
            }
        }

        connection.start().then(function () {
            console.log("Connected to Booking Hub!");
        }).catch(function (err) {
            console.error("SignalR Connection Error: ", err.toString());
        });
    </script>
}