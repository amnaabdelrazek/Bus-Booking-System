@model Bus_Booking_System.ViewModel.TripIndexVM
@{
    ViewData["Title"] = "Trips";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap" rel="stylesheet">

<div class="container my-5" style="font-family: 'Inter', sans-serif;">
    <div class="d-flex justify-content-between align-items-end mb-4">
        <div>
            <h2 class="fw-bold mb-1 text-dark">Available Trips</h2>
            <p class="text-muted mb-0" id="TripsCountText"><i class="bi bi-bus-front me-2"></i>@Model.Trips.Count trips found for your search</p>
        </div>
    </div>

    <div class="row">
        <div class="col-lg-3 mb-4">
            <div class="card border-0 shadow-sm p-4 sticky-top" style="border-radius: 20px; top: 20px; z-index: 100;">
                <h5 class="fw-bold mb-4 d-flex align-items-center">
                    <i class="bi bi-sliders2 me-2 text-primary"></i> Filters
                </h5>
                <form asp-action="Index" method="get">
                    <div class="mb-4">
                        <label class="form-label text-uppercase ls-1 text-muted fw-bold small">Travel Date</label>
                        <input type="date" name="travelDate" class="form-control border-0 bg-light py-2" style="border-radius: 10px;" value="@Model.FilterDate?.ToString("yyyy-MM-dd")">
                    </div>

                    <div class="mb-4">
                        <label class="form-label text-uppercase ls-1 text-muted fw-bold small">Trip Status</label>
                        <select name="status" class="form-select border-0 bg-light py-2" style="border-radius: 10px;">
                            <option value="">All Statuses</option>
                            <option value="OpenForBooking">Open For Booking</option>
                            <option value="Cancelled">Cancelled</option>
                            <option value="Completed">Completed</option>
                        </select>
                    </div>

                    <div class="mb-4">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <label class="form-label text-uppercase ls-1 text-muted fw-bold small mb-0">Max Price</label>
                            <span class="badge bg-primary-subtle text-primary fw-bold" style="font-size: 0.9rem;">$<span id="priceValue">@Model.FilterMaxPrice</span></span>
                        </div>
                        <input type="range" name="maxPrice" class="form-range custom-range" min="@Model.MinPrice" max="@Model.MaxPrice" step="5" value="@Model.FilterMaxPrice"
                               oninput="document.getElementById('priceValue').innerText = this.value" />
                        <div class="d-flex justify-content-between mt-1">
                            <span class="text-muted smaller fw-medium">$@Model.MinPrice</span>
                            <span class="text-muted smaller fw-medium">$@Model.MaxPrice</span>
                        </div>
                    </div>

                    <button type="submit" class="btn btn-primary w-100 py-2 mb-2 fw-bold" style="border-radius: 12px; transition: all 0.3s;">
                        Apply Filters
                    </button>
                    <a asp-action="Index" class="btn btn-link w-100 text-decoration-none text-muted small fw-bold">Clear All</a>
                </form>
            </div>
        </div>

        <div class="col-lg-9" id="TripsCardsContainer">
            <partial name="_TripsCardsPartial" model="Model" />
        </div>
    </div>
</div>

<style>
    /* تحسينات التصميم العام */
    body {
        background-color: #f8f9fa;
    }

    .ls-1 {
        letter-spacing: 1px;
    }

    .smaller {
        font-size: 0.75rem;
    }

    /* تأثيرات البطاقة (Card) */
    .trip-card {
        transition: all 0.3s cubic-bezier(.25,.8,.25,1);
        border: 1px solid rgba(0,0,0,0.02);
    }

        .trip-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 15px 30px rgba(0,0,0,0.1) !important;
        }

    /* تقسيم المسار */
    .route-divider {
        position: relative;
        height: 2px;
        background: #e9ecef;
        width: 100%;
    }

        .route-divider i {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            background: white;
            padding: 0 5px;
            font-size: 1.2rem;
        }

    /* حالات الرحلة */
    .trip-cancelled {
        opacity: 0.6;
        filter: grayscale(1);
        pointer-events: none;
    }

    .trip-completed {
        opacity: 0.8;
    }

    /* تحسين شريط السعر */
    .custom-range::-webkit-slider-thumb {
        background: #0d6efd;
        border: 2px solid #fff;
        box-shadow: 0 0 5px rgba(0,0,0,0.2);
    }

    /* الألوان الفرعية */
    .bg-success-subtle {
        background-color: #e8f5e9;
    }

    .bg-primary-subtle {
        background-color: #e3f2fd;
    }

    .bg-danger-subtle {
        background-color: #ffebee;
    }
</style>

@section Scripts {
    <script src="~/lib/jquery/dist/jquery.js"></script>
    <script src="~/lib/microsoft-signalr/signalr.min.js"></script>
    <script>
        var connection = new signalR.HubConnectionBuilder()
            .withUrl("/bookingHub")
            .build();

        connection.on("UpdateSeatStatus", function (tripId, seatIds, status, isFull) {
            var seatsElement = document.getElementById("seats-count-" + tripId);
            if (seatsElement) {
                var currentCount = parseInt(seatsElement.innerText);
                var numberOfSeats = Array.isArray(seatIds) ? seatIds.length : 1;
                var newCount = (status === "Booked") ? Math.max(0, currentCount - numberOfSeats) : currentCount + numberOfSeats;

                seatsElement.innerText = newCount + " Seats left";

                var parentDiv = seatsElement.parentElement;
                if (newCount < 5) {
                    parentDiv.classList.add("text-danger", "fw-bold");
                    parentDiv.classList.remove("text-muted");
                } else {
                    parentDiv.classList.remove("text-danger", "fw-bold");
                    parentDiv.classList.add("text-muted");
                }

                if (isFull || newCount <= 0) {
                    location.reload(); // لإعادة تحميل الحالة الكاملة للرحلة في حال امتلاء الحافلة
                }
            }
        });

        connection.on("ReceiveTripsUpdate", function () {
            loadTripsPartial();
        });

        function loadTripsPartial() {
            var partialUrl = '@Url.Action("GetTripsPartial", "Trip")' + window.location.search;

            $("#TripsCardsContainer").load(partialUrl, function () {
                updateTripsCount();
            });
        }

        function updateTripsCount() {
            var tripsCount = $("#TripsCountValue").val();

            if (tripsCount != undefined) {
                $("#TripsCountText").html('<i class="bi bi-bus-front me-2"></i>' + tripsCount + ' trips found for your search');
            }
        }

        connection.start().catch(function (err) {
            console.error(err.toString());
        });
    </script>
}
