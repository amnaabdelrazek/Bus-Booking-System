@model Bus_Booking_System.ViewModel.TripIndexVM
@{
    ViewData["Title"] = "Trips";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap" rel="stylesheet">

<div class="container my-5" style="font-family: 'Inter', sans-serif;">
    <div class="d-flex justify-content-between align-items-end mb-4">
        <div>
            <h2 class="fw-bold mb-1 text-dark">Available Trips</h2>
            <p class="text-muted mb-0"><i class="bi bi-bus-front me-2"></i>@Model.Trips.Count trips found for your search</p>
        </div>
    </div>

    <div class="row">
        <div class="col-lg-3 mb-4">
            <div class="card border-0 shadow-sm p-4 sticky-top" style="border-radius: 20px; top: 20px; z-index: 100;">
                <h5 class="fw-bold mb-4 d-flex align-items-center">
                    <i class="bi bi-sliders2 me-2 text-primary"></i> Filters
                </h5>
                <form asp-action="Index" method="get">
                    <div class="mb-4">
                        <label class="form-label text-uppercase ls-1 text-muted fw-bold small">Travel Date</label>
                        <input type="date" name="travelDate" class="form-control border-0 bg-light py-2" style="border-radius: 10px;" value="@Model.FilterDate?.ToString("yyyy-MM-dd")">
                    </div>

                    <div class="mb-4">
                        <label class="form-label text-uppercase ls-1 text-muted fw-bold small">Trip Status</label>
                        <select name="status" class="form-select border-0 bg-light py-2" style="border-radius: 10px;">
                            <option value="">All Statuses</option>
                            <option value="OpenForBooking">Open For Booking</option>
                            <option value="Cancelled">Cancelled</option>
                            <option value="Completed">Completed</option>
                        </select>
                    </div>

                    <div class="mb-4">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <label class="form-label text-uppercase ls-1 text-muted fw-bold small mb-0">Max Price</label>
                            <span class="badge bg-primary-subtle text-primary fw-bold" style="font-size: 0.9rem;">$<span id="priceValue">@Model.FilterMaxPrice</span></span>
                        </div>
                        <input type="range" name="maxPrice" class="form-range custom-range" min="@Model.MinPrice" max="@Model.MaxPrice" step="5" value="@Model.FilterMaxPrice"
                               oninput="document.getElementById('priceValue').innerText = this.value" />
                        <div class="d-flex justify-content-between mt-1">
                            <span class="text-muted smaller fw-medium">$@Model.MinPrice</span>
                            <span class="text-muted smaller fw-medium">$@Model.MaxPrice</span>
                        </div>
                    </div>

                    <button type="submit" class="btn btn-primary w-100 py-2 mb-2 fw-bold" style="border-radius: 12px; transition: all 0.3s;">
                        Apply Filters
                    </button>
                    <a asp-action="Index" class="btn btn-link w-100 text-decoration-none text-muted small fw-bold">Clear All</a>
                </form>
            </div>
        </div>

        <div class="col-lg-9">
            <div class="row g-4">
                @if (!Model.Trips.Any())
                {
                    <div class="col-12 text-center py-5 bg-white rounded-4 shadow-sm">
                        <img src="https://illustrations.popsy.co/gray/bus-stop.svg" style="width: 200px;" alt="No trips">
                        <h5 class="text-dark fw-bold mt-4">No trips match your filters</h5>
                        <p class="text-muted">Try adjusting your filters to find more options.</p>
                    </div>
                }
                else
                {
                    @foreach (var trip in Model.Trips)
                    {
                        bool isCancelled = trip.Status == "Cancelled";
                        bool isCompleted = trip.Status == "Completed";
                        bool isOpen = trip.Status == "OpenForBooking";

                        string cardClass = isCancelled ? "trip-cancelled" : (isCompleted ? "trip-completed" : "");
                        string badgeClass = trip.Status switch
                        {
                            "OpenForBooking" => "bg-success-subtle text-success border-success",
                            "Completed" => "bg-primary-subtle text-primary border-primary",
                            "Cancelled" => "bg-danger-subtle text-danger border-danger",
                            _ => "bg-light text-muted"
                        };

                        <div class="col-md-6">
                            <div class="card border-0 shadow-sm trip-card h-100 @cardClass" style="border-radius: 20px; overflow: hidden;">
                                <div class="card-body p-4">
                                    <div class="d-flex justify-content-between align-items-center mb-4">
                                        <span class="badge border rounded-pill px-3 py-2 fw-bold @badgeClass" style="font-size: 0.75rem;">
                                            @if (isOpen)
                                            {
                                                <i class="bi bi-check2-circle me-1"></i>
                                            }
                                            @if (isCancelled)
                                            {
                                                <i class="bi bi-x-circle me-1"></i>
                                            }
                                            @if (isCompleted)
                                            {
                                                <i class="bi bi-flag me-1"></i>
                                            }
                                            @trip.Status
                                        </span>
                                        <div class="text-end">
                                            <small class="d-block text-muted text-uppercase fw-bold" style="font-size: 0.65rem; letter-spacing: 0.5px;">Departure</small>
                                            <small class="fw-bold text-dark">@trip.Date.ToString("ddd, dd MMM yyyy")</small>
                                        </div>
                                    </div>

                                    <div class="row align-items-center mb-4">
                                        <div class="col-5">
                                            <h5 class="fw-bold text-dark mb-1">@trip.FromCity</h5>
                                            <div class="text-primary fw-bold" style="font-size: 0.85rem;">
                                                <i class="bi bi-clock me-1"></i> @trip.DepartureTime.ToString("hh:mm tt")
                                            </div>
                                        </div>
                                        <div class="col-2 text-center">
                                            <div class="route-divider">
                                                <i class="bi bi-bus-front text-muted"></i>
                                            </div>
                                        </div>
                                        <div class="col-5 text-end">
                                            <h5 class="fw-bold text-dark mb-1">@trip.ToCity</h5>
                                            <div class="text-muted fw-medium" style="font-size: 0.85rem;">
                                                <i class="bi bi-clock-history me-1"></i> @trip.ArrivalTime.ToString("hh:mm tt")
                                            </div>
                                        </div>
                                    </div>

                                    <div class="d-flex justify-content-between bg-light rounded-3 p-3 mb-4">
                                        <div class="small text-muted">
                                            <i class="bi bi-shield-check text-primary me-1"></i> @trip.BusType
                                        </div>
                                        <div class="small @(trip.AvailableSeats < 5 ? "text-danger fw-bold" : "text-muted")">
                                            <i class="bi bi-person-check me-1"></i>
                                            <span id="seats-count-@trip.tripId">@trip.AvailableSeats Seats left</span>
                                        </div>
                                    </div>

                                    <div class="d-flex justify-content-between align-items-center">
                                        <div>
                                            <span class="text-muted small">Total Price</span>
                                            <div class="h4 fw-bold text-dark mb-0">$@trip.Price <span class="small text-muted" style="font-size: 0.7rem;">/seat</span></div>
                                        </div>

                                        <div class="btn-group">
                                            @if (isOpen)
                                            {
                                                <a asp-controller="Trip" asp-action="ShowTrip" asp-route-id="@trip.tripId" class="btn btn-dark px-4 py-2 fw-bold" style="border-radius: 12px; transition: all 0.3s;">
                                                    Book Now <i class="bi bi-arrow-right ms-1"></i>
                                                </a>
                                            }
                                            else
                                            {
                                                <button class="btn btn-outline-secondary disabled px-4" style="border-radius: 12px; font-size: 0.8rem;">
                                                    @(isCancelled ? "Cancelled" : "Full / Completed")
                                                </button>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                }
            </div>
        </div>
    </div>
</div>

<style>
    /* تحسينات التصميم العام */
    body {
        background-color: #f8f9fa;
    }

    .ls-1 {
        letter-spacing: 1px;
    }

    .smaller {
        font-size: 0.75rem;
    }

    /* تأثيرات البطاقة (Card) */
    .trip-card {
        transition: all 0.3s cubic-bezier(.25,.8,.25,1);
        border: 1px solid rgba(0,0,0,0.02);
    }

        .trip-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 15px 30px rgba(0,0,0,0.1) !important;
        }

    /* تقسيم المسار */
    .route-divider {
        position: relative;
        height: 2px;
        background: #e9ecef;
        width: 100%;
    }

        .route-divider i {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            background: white;
            padding: 0 5px;
            font-size: 1.2rem;
        }

    /* حالات الرحلة */
    .trip-cancelled {
        opacity: 0.6;
        filter: grayscale(1);
        pointer-events: none;
    }

    .trip-completed {
        opacity: 0.8;
    }

    /* تحسين شريط السعر */
    .custom-range::-webkit-slider-thumb {
        background: #0d6efd;
        border: 2px solid #fff;
        box-shadow: 0 0 5px rgba(0,0,0,0.2);
    }

    /* الألوان الفرعية */
    .bg-success-subtle {
        background-color: #e8f5e9;
    }

    .bg-primary-subtle {
        background-color: #e3f2fd;
    }

    .bg-danger-subtle {
        background-color: #ffebee;
    }
</style>

@section Scripts {
    <script src="~/lib/jquery/dist/jquery.js"></script>
    <script src="~/lib/microsoft-signalr/signalr.min.js"></script>
    <script>
        const connection = new signalR.HubConnectionBuilder()
            .withUrl("/bookingHub")
            .build();

        connection.on("UpdateSeatStatus", function (tripId, seatIds, status, isFull) {
            const seatsElement = document.getElementById(`seats-count-${tripId}`);
            if (seatsElement) {
                let currentCount = parseInt(seatsElement.innerText);
                let numberOfSeats = Array.isArray(seatIds) ? seatIds.length : 1;
                let newCount = (status === "Booked") ? Math.max(0, currentCount - numberOfSeats) : currentCount + numberOfSeats;

                seatsElement.innerText = newCount + " Seats left";

                const parentDiv = seatsElement.parentElement;
                if (newCount < 5) {
                    parentDiv.classList.add("text-danger", "fw-bold");
                    parentDiv.classList.remove("text-muted");
                } else {
                    parentDiv.classList.remove("text-danger", "fw-bold");
                    parentDiv.classList.add("text-muted");
                }

                if (isFull || newCount <= 0) {
                    location.reload(); // لإعادة تحميل الحالة الكاملة للرحلة في حال امتلاء الحافلة
                }
            }
        });

        connection.start().catch(err => console.error(err.toString()));
    </script>
}