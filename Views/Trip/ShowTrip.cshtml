@model Bus_Booking_System.ViewModel.TripSeatBookingVM
@{
    ViewData["Title"] = "Select Seats";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

<style>
    body {
        background-color: #f4f7f6;
    }

    /* تصميم هيكل الأتوبيس */
    .bus-wrapper {
        background: #ffffff;
        border: 2px solid #ddd;
        border-radius: 40px 40px 20px 20px;
        padding: 40px 20px;
        max-width: 400px;
        margin: auto;
        box-shadow: 0 10px 30px rgba(0,0,0,0.05);
        position: relative;
    }

    /* مقدمة الأتوبيس */
    .bus-front {
        border-bottom: 4px solid #eee;
        margin-bottom: 30px;
        padding-bottom: 10px;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .seat-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr) 40px repeat(2, 1fr);
        gap: 12px;
        text-align: center;
    }

    .aisle {
        grid-column: 3;
    }

    /* تصميم الكرسي */
    .btn-seat {
        width: 100%;
        height: 50px;
        border-radius: 8px;
        font-weight: bold;
        font-size: 0.9rem;
        transition: all 0.2s;
        border: 2px solid #dee2e6;
        background: white;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
    }

        .btn-seat:hover:not(.disabled) {
            border-color: #0d6efd;
            color: #0d6efd;
            transform: translateY(-2px);
        }

    /* الكرسي المحجوز */
    .seat-booked {
        background-color: #e9ecef !important;
        color: #adb5bd !important;
        border-color: #dee2e6 !important;
        cursor: not-allowed;
        opacity: 0.6;
    }

    /* الكرسي المختار */
    .seat-selected {
        background-color: #0d6efd !important;
        color: white !important;
        border-color: #0d6efd !important;
        box-shadow: 0 4px 10px rgba(13, 110, 253, 0.3);
    }

    /* دليل الألوان (Legend) */
    .legend {
        display: flex;
        justify-content: center;
        gap: 20px;
        margin-top: 25px;
        font-size: 0.85rem;
    }

    .legend-item {
        display: flex;
        align-items: center;
        gap: 5px;
    }

    .legend-box {
        width: 18px;
        height: 18px;
        border-radius: 4px;
    }

    .summary-card {
        border-radius: 20px;
        border: none;
        overflow: hidden;
    }
</style>

<div class="container my-5">
    <div class="row g-4">
        <div class="col-lg-8">
            <div class="card shadow-sm p-4 border-0" style="border-radius:25px;">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h3 class="fw-bold m-0"><i class="bi bi-bus-front me-2"></i>Select Your Seat</h3>
                    <span class="text-muted small">Trip ID: #@Model.TripId</span>
                </div>

                <div class="bus-wrapper">
                    <div class="bus-front">
                        <div class="text-muted"><i class="bi bi-door-open fs-4"></i> Entrance</div>
                        <div class="badge bg-dark p-2">
                            <i class="bi bi-person-badge me-1"></i> DRIVER
                        </div>
                    </div>

                    <div class="seat-grid">
                        @for (int i = 1; i <= Model.TotalSeats; i++)
                        {
                            var seatNum = i.ToString();
                            var isBooked = Model.BookedSeats?.Contains(seatNum) ?? false;

                            if (isBooked)
                            {
                                <div id="seat-@seatNum" class="btn-seat seat-booked disabled">
                                    <i class="bi bi-x-circle"></i>
                                </div>
                            }
                            else
                            {
                                <button id="seat-@seatNum" type="button" class="btn-seat"
                                        onclick="selectSeat(this, '@seatNum', @Model.Price)">
                                    @seatNum
                                </button>
                            }

                            if (i % 2 == 0 && i % 4 != 0)
                            {
                                <div class="aisle"></div>
                            }
                        }
                    </div>

                    <div class="legend border-top pt-3">
                        <div class="legend-item">
                            <div class="legend-box border"></div> <span>Available</span>
                        </div>
                        <div class="legend-item">
                            <div class="legend-box bg-primary"></div> <span>Selected</span>
                        </div>
                        <div class="legend-item">
                            <div class="legend-box bg-light border"></div> <span>Booked</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card shadow-sm sticky-top summary-card" style="top:20px;">
                <div class="card-header bg-dark text-white p-3">
                    <h5 class="m-0 fw-bold">Trip Summary</h5>
                </div>
                <div class="card-body p-4">
                    <div class="mb-4">
                        <label class="text-muted small d-block">ROUTE</label>
                        <div class="d-flex align-items-center">
                            <span class="fw-bold fs-5">@Model.FromCity</span>
                            <i class="bi bi-arrow-right mx-2 text-primary"></i>
                            <span class="fw-bold fs-5">@Model.ToCity</span>
                        </div>
                    </div>

                    <div class="row g-3 mb-4">
                        <div class="col-6">
                            <label class="text-muted small d-block">DATE</label>
                            <span class="fw-bold small"><i class="bi bi-calendar-event me-1"></i>@Model.Date.ToString("dd MMM, yyyy")</span>
                        </div>
                        <div class="col-6">
                            <label class="text-muted small d-block">TIME</label>
                            <span class="fw-bold small"><i class="bi bi-clock me-1"></i>@Model.Time.ToString("hh:mm tt")</span>
                        </div>
                    </div>

                    <div class="p-3 bg-light rounded-3 mb-4">
                        <div class="d-flex justify-content-between">
                            <span class="text-muted">Price per seat:</span>
                            <span class="fw-bold text-dark">$@Model.Price</span>
                        </div>
                    </div>

                    <div id="selectionSummary" style="display:none;">
                        <hr>
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted">Selected Seats:</span>
                            <span id="selectedSeatsList" class="badge bg-primary fs-6"></span>
                        </div>
                        <div class="d-flex justify-content-between align-items-center mt-3">
                            <span class="h6 m-0 fw-bold">Total Amount:</span>
                            <span class="h4 m-0 fw-bold text-primary">$<span id="totalPriceDisplay">0</span></span>
                        </div>
                        <button onclick="goToConfirmation()" class="btn btn-primary w-100 mt-4 py-3 fw-bold shadow-sm">
                            Confirm Booking <i class="bi bi-chevron-right ms-1"></i>
                        </button>
                    </div>

                    <div id="noSelectionMsg" class="text-center text-muted small py-3">
                        <i class="bi bi-info-circle me-1"></i> Please select a seat to continue
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="~/lib/jquery/dist/jquery.js"></script>
<script src="~/lib/microsoft-signalr/signalr.min.js"></script>

<script>
    let selectedSeats = [];

    const connection = new signalR.HubConnectionBuilder().withUrl("/bookingHub").build();
    connection.start();

    connection.on("UpdateSeatStatus", function (tripId, seatIds, status) {
        if (tripId == "@Model.TripId") {
            seatIds.forEach(id => {
                const $btn = $(`#seat-${id}`);
                if ($btn.length > 0) {
                    if (status === "Booked") {
                        $btn.addClass("seat-booked disabled")
                            .removeClass("seat-selected")
                            .html('<i class="bi bi-x-circle"></i>')
                            .off("click");

                        selectedSeats = selectedSeats.filter(s => s !== id.toString());
                    }
                    else if (status === "Available") {
                        $btn.removeClass("seat-booked disabled")
                            .text(id)
                            .off("click").on("click", function () {
                                selectSeat(this, id.toString(), @Model.Price);
                            });
                    }
                }
            });
            updateUI(@Model.Price);
        }
    });

    function selectSeat(button, seatId, price) {
        const $btn = $(button);

        if (selectedSeats.includes(seatId)) {
            selectedSeats = selectedSeats.filter(s => s !== seatId);
            $btn.removeClass("seat-selected");
        } else {
            // اختياري: تحديد أقصى عدد للمقاعد (مثلاً 6)
            if (selectedSeats.length >= 6) {
                alert("You can only select up to 6 seats.");
                return;
            }
            selectedSeats.push(seatId);
            $btn.addClass("seat-selected");
        }
        updateUI(price);
    }

    function updateUI(price) {
        const summary = document.getElementById("selectionSummary");
        const msg = document.getElementById("noSelectionMsg");

        if (selectedSeats.length > 0) {
            summary.style.display = "block";
            msg.style.display = "none";
            document.getElementById("selectedSeatsList").innerText = selectedSeats.sort((a, b) => a - b).join(", ");
            document.getElementById("totalPriceDisplay").innerText = selectedSeats.length * price;
        } else {
            summary.style.display = "none";
            msg.style.display = "block";
        }
    }

    function goToConfirmation() {
        const tripId = "@Model.TripId";
        const price = "@Model.Price";
        window.location.href = `/Booking/Confirm?tripId=${tripId}&seats=${selectedSeats.join(",")}&price=${price}`;
    }
</script>