@model Bus_Booking_System.Models.Booking
@{
    ViewData["Title"] = "Edit Booking Status";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<style>
    :root {
        --primary-blue: #0056b3;
        --dark-blue: #0d2b4d;
    }

    .custom-card {
        background: #ffffff;
        border-radius: 16px;
        border: none;
        box-shadow: 0 8px 24px rgba(13, 43, 77, 0.08);
    }

    .summary-box {
        background-color: #f8f9fa;
        border-left: 4px solid var(--primary-blue);
        border-radius: 8px;
    }

    .btn-primary-custom {
        background-color: var(--primary-blue);
        color: white;
        border: none;
        border-radius: 8px;
        padding: 10px 24px;
        font-weight: 600;
        transition: all 0.3s ease;
    }

        .btn-primary-custom:hover {
            background-color: var(--dark-blue);
            color: white;
            transform: translateY(-2px);
        }
</style>

<div class="container py-5 d-flex justify-content-center">
    <div class="custom-card w-100 p-0 overflow-hidden" style="max-width: 550px;">
        <div class="p-4 border-bottom text-center" style="background-color: var(--dark-blue); color: white;">
            <i class="bi bi-pencil-square display-6 mb-2 d-block text-white opacity-75"></i>
            <h4 class="fw-bold mb-0">Edit Booking Status</h4>
        </div>

        <div class="card-body p-4 p-md-5">
            <div class="summary-box p-4 mb-4">
                <div class="d-flex justify-content-between align-items-center mb-3 border-bottom pb-2">
                    <span class="text-muted fw-bold small text-uppercase">Reference</span>
                    <span class="fw-bold fs-5" style="color: var(--primary-blue);">#BK-@Model.Id.ToString("D4")</span>
                </div>

                <div class="row g-3">
                    <div class="col-6">
                        <label class="text-muted small d-block mb-1">Passenger</label>
                        <span class="fw-bold text-dark"><i class="bi bi-person me-1"></i>@Model.User?.UserName</span>
                    </div>
                    <div class="col-6 text-end">
                        <label class="text-muted small d-block mb-1">Total Price</label>
                        <span class="fw-bold text-success fs-5">$@Model.TotalPrice</span>
                    </div>
                    <div class="col-12 mt-3">
                        <label class="text-muted small d-block mb-1">Route & Date</label>
                        <div class="fw-bold text-dark">
                            @Model.Trip?.BusRoute?.OriginCity?.Name ➔ @Model.Trip?.BusRoute?.DestinationCity?.Name
                        </div>
                        <small class="text-muted"><i class="bi bi-calendar3 me-1"></i>@Model.Trip?.TravelDate.ToString("MMM dd, yyyy")</small>
                    </div>
                </div>
            </div>

            <form asp-action="Edit">
                <input type="hidden" asp-for="Id" />

                <div class="mb-5">
                    <label asp-for="Status" class="form-label fw-bold" style="color: var(--dark-blue);">Update Status</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0"><i class="bi bi-activity text-muted"></i></span>
                        <select asp-for="Status" class="form-select border-start-0 ps-0 fw-bold" style="height: 50px;">
                            <option value="0">⏳ Pending</option>
                            <option value="2">✅ Confirmed</option>
                            <option value="1">❌ Cancelled</option>
                        </select>
                    </div>
                    <span asp-validation-for="Status" class="text-danger small mt-1 d-block"></span>
                </div>

                <div class="d-flex gap-3 pt-2 border-top mt-4 pt-4">
                    <a asp-action="Index" class="btn btn-light fw-bold w-50 py-2" style="border-radius: 8px; color: #6c757d;">
                        Cancel
                    </a>
                    <button type="submit" class="btn btn-primary-custom w-50 py-2">
                        <i class="bi bi-save me-2"></i>Save Changes
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}