@model Bus_Booking_System.Models.Booking
@{
    ViewData["Title"] = "Edit Booking Status";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="card border-0 shadow-sm rounded-3" style="max-width: 600px;">
    <div class="card-header bg-white border-bottom-0 pt-4 pb-0">
        <h4 class="fw-bold text-muted"><i class="bi bi-pencil-square me-2"></i>Edit Booking Status</h4>
    </div>

    <div class="card-body p-4">
        <div class="bg-light p-3 rounded-3 mb-4">
            <h6 class="fw-bold text-primary mb-3">Booking Reference: #BK-@Model.Id.ToString("D4")</h6>
            <p class="mb-1"><strong>Passenger:</strong> @Model.User?.UserName</p>
            <p class="mb-1"><strong>Route:</strong> @Model.Trip?.BusRoute?.OriginCity?.Name ➔ @Model.Trip?.BusRoute?.DestinationCity?.Name</p>
            <p class="mb-1"><strong>Travel Date:</strong> @Model.Trip?.TravelDate.ToString("MMM dd, yyyy")</p>
            <p class="mb-0"><strong>Total Price:</strong> <span class="text-success fw-bold">$@Model.TotalPrice</span></p>
        </div>

        <form asp-action="Edit">
            <input type="hidden" asp-for="Id" />

            <div class="mb-4">
                <label asp-for="Status" class="form-label fw-bold">Update Status</label>
                <select asp-for="Status" class="form-select fw-bold border-primary">
                    <option value="0" class="text-warning">Pending</option>
                    <option value="2" class="text-success">Confirmed</option>
                    <option value="1" class="text-danger">Cancelled</option>
                </select>
                <span asp-validation-for="Status" class="text-danger small"></span>
            </div>

            <div class="d-flex justify-content-between border-top pt-4">
                <a asp-action="Index" class="btn btn-light">Cancel</a>
                <button type="submit" class="btn btn-primary"><i class="bi bi-save me-2"></i>Save Status</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

}