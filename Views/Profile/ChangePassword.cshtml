@model Bus_Booking_System.ViewModel.ChangePasswordVM

@{
    ViewData["Title"] = "Change Password";
}

<style>
    :root {
        --primary-blue: #0d6efd;
        --dark-navy: #1e293b;
        --bg-soft: #f8fafc;
    }

    .security-card {
        background: #ffffff;
        border-radius: 25px;
        border: none;
        box-shadow: 0 15px 40px rgba(0,0,0,0.08);
        padding: 40px;
        position: relative;
        overflow: hidden;
    }

        /* الشريط العلوي للزينة */
        .security-card::before {
            content: "";
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 6px;
            background: linear-gradient(90deg, var(--primary-blue), var(--dark-navy));
        }

    .form-label {
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 0.8px;
        color: #64748b;
        font-weight: 700;
        margin-bottom: 8px;
    }

    .input-group-text {
        background-color: var(--bg-soft);
        border: 1px solid #e2e8f0;
        border-right: none;
        border-radius: 12px 0 0 12px;
        color: #94a3b8;
        padding-left: 15px;
        padding-right: 15px;
    }

    .form-control {
        border: 1px solid #e2e8f0;
        border-radius: 0 12px 12px 0;
        padding: 12px;
        font-size: 0.95rem;
        transition: all 0.3s ease;
        border-left: none;
    }

        .form-control:focus {
            border-color: #e2e8f0; 
            box-shadow: none;
            background-color: #fff;
        }

    .input-group:focus-within .input-group-text {
        border-color: var(--primary-blue);
        color: var(--primary-blue);
    }

    .input-group:focus-within .form-control {
        border-color: var(--primary-blue);
    }

    .btn-update {
        background: var(--dark-navy);
        color: white;
        border-radius: 12px;
        padding: 14px;
        font-weight: 600;
        border: none;
        transition: all 0.3s;
    }

        .btn-update:hover {
            background: #000;
            transform: translateY(-2px);
            box-shadow: 0 8px 15px rgba(0,0,0,0.1);
        }

    .btn-back {
        background: transparent;
        color: #64748b;
        border: 2px solid #f1f5f9;
        border-radius: 12px;
        padding: 12px;
        font-weight: 600;
        transition: all 0.2s;
    }

        .btn-back:hover {
            background: #f8fafc;
            color: var(--dark-navy);
            border-color: #e2e8f0;
        }
</style>

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-5">

            <div class="security-card">
                <div class="text-center mb-4">
                    <div class="avatar-icon mb-3">
                        <i class="bi bi-shield-lock-fill text-primary" style="font-size: 3.5rem; opacity: 0.9;"></i>
                    </div>
                    <h3 class="fw-bold text-dark">Security Settings</h3>
                    <p class="text-muted small">Update your password to keep your account safe</p>
                </div>

                <form asp-action="ChangePassword" method="post">

                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div asp-validation-summary="All" class="alert alert-danger border-0 small py-2 mb-4" style="border-radius: 12px;"></div>
                    }

                    <div class="mb-3">
                        <label asp-for="CurrentPassword" class="form-label"></label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-key-fill"></i></span>
                            <input asp-for="CurrentPassword" type="password" class="form-control" placeholder="Current password" />
                        </div>
                        <span asp-validation-for="CurrentPassword" class="text-danger small ms-1"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="NewPassword" class="form-label"></label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-lock-fill"></i></span>
                            <input asp-for="NewPassword" type="password" class="form-control" placeholder="New password" />
                        </div>
                        <span asp-validation-for="NewPassword" class="text-danger small ms-1"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="ConfirmNewPassword" class="form-label"></label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-shield-fill-check"></i></span>
                            <input asp-for="ConfirmNewPassword" type="password" class="form-control" placeholder="Confirm new password" />
                        </div>
                        <span asp-validation-for="ConfirmNewPassword" class="text-danger small ms-1"></span>
                    </div>

                    <div class="d-grid gap-3">
                        <button type="submit" class="btn btn-update">
                            Update Password <i class="bi bi-arrow-repeat ms-1"></i>
                        </button>
                        <a asp-controller="Profile" asp-action="Index" class="btn btn-back">
                            Cancel & Return
                        </a>
                    </div>
                </form>
            </div>

            <div class="mt-4 text-center">
                <p class="text-muted" style="font-size: 0.85rem;">
                    <i class="bi bi-info-circle me-1"></i>
                    We recommend using a password at least 8 characters long.
                </p>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}