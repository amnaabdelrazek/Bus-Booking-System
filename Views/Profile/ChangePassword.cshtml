@model Bus_Booking_System.ViewModel.ChangePasswordVM

@{
    ViewData["Title"] = "Change Password";
}

<div class="d-flex justify-content-center align-items-center my-5">
    <div class="custom-card w-100" style="max-width: 450px;">
        <div class="text-center mb-4">
            <h3 class="fw-bold" style="color: var(--dark-blue);">Change Password</h3>
            <p class="text-muted small">Update your password to keep your account secure.</p>
        </div>

        <form asp-action="ChangePassword" method="post">
            <div asp-validation-summary="All" class="text-danger small mb-3"></div>

            <div class="mb-3">
                <label asp-for="CurrentPassword" class="form-label text-muted small fw-bold">Current Password</label>
                <div class="input-group">
                    <span class="input-group-text bg-light border-end-0"><i class="bi bi-key text-muted"></i></span>
                    <input asp-for="CurrentPassword" type="password" class="form-control border-start-0 ps-0" placeholder="Enter current password" />
                </div>
                <span asp-validation-for="CurrentPassword" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="NewPassword" class="form-label text-muted small fw-bold">New Password</label>
                <div class="input-group">
                    <span class="input-group-text bg-light border-end-0"><i class="bi bi-lock text-muted"></i></span>
                    <input asp-for="NewPassword" type="password" class="form-control border-start-0 ps-0" placeholder="Enter new password" />
                </div>
                <span asp-validation-for="NewPassword" class="text-danger small"></span>
            </div>

            <div class="mb-4">
                <label asp-for="ConfirmNewPassword" class="form-label text-muted small fw-bold">Confirm New Password</label>
                <div class="input-group">
                    <span class="input-group-text bg-light border-end-0"><i class="bi bi-shield-lock text-muted"></i></span>
                    <input asp-for="ConfirmNewPassword" type="password" class="form-control border-start-0 ps-0" placeholder="Confirm new password" />
                </div>
                <span asp-validation-for="ConfirmNewPassword" class="text-danger small"></span>
            </div>

            <button type="submit" class="btn btn-primary-custom w-100 text-white mb-2">
                Update Password
            </button>

            <a asp-controller="Profile" asp-action="Index" class="btn btn-light w-100 text-muted">
                Back to Profile
            </a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}