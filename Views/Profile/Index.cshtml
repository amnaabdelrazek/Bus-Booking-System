@model Bus_Booking_System.ViewModel.ProfileDetailsVM

@{
    ViewData["Title"] = "My Profile";
}

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">

            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm mb-4" role="alert" style="border-radius: 12px;">
                    <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            <div class="custom-card shadow-sm">
                <div class="text-center mb-4">
                    <div class="display-1 text-primary mb-3">
                        <i class="bi bi-person-circle"></i>
                    </div>
                    <h3 class="fw-bold" style="color: var(--dark-blue);">Account Settings</h3>
                    <p class="text-muted small">Manage your personal information and security</p>
                </div>

                <hr class="opacity-10 mb-4">

                <div class="profile-details">
                    <div class="d-flex align-items-center mb-4">
                        <div class="icon-box bg-light text-primary rounded-circle p-3 me-3">
                            <i class="bi bi-person-badge fs-5"></i>
                        </div>
                        <div>
                            <label class="text-muted small d-block mb-0">Full Name</label>
                            <span class="fw-bold text-dark">
                                @(string.IsNullOrEmpty(Model.FullName) ? "Not Added" : Model.FullName)
                            </span>
                        </div>
                    </div>

                    <div class="d-flex align-items-center mb-4">
                        <div class="icon-box bg-light text-primary rounded-circle p-3 me-3">
                            <i class="bi bi-at fs-5"></i>
                        </div>
                        <div>
                            <label class="text-muted small d-block mb-0">Username</label>
                            <span class="fw-bold text-dark">@Model.UserName</span>
                        </div>
                    </div>

                    <div class="d-flex align-items-center mb-4">
                        <div class="icon-box bg-light text-primary rounded-circle p-3 me-3">
                            <i class="bi bi-envelope fs-5"></i>
                        </div>
                        <div>
                            <label class="text-muted small d-block mb-0">Email Address</label>
                            <span class="fw-bold text-dark">@Model.Email</span>
                        </div>
                    </div>

                    <div class="d-flex align-items-center mb-4">
                        <div class="icon-box bg-light text-primary rounded-circle p-3 me-3">
                            <i class="bi bi-telephone fs-5"></i>
                        </div>
                        <div>
                            <label class="text-muted small d-block mb-0">Phone Number</label>
                            <span class="fw-bold text-dark">@Model.Phone</span>
                        </div>
                    </div>
                </div>

                <hr class="opacity-10 my-4">

                <div class="row g-2">
                    <div class="col-6">
                        <a asp-action="Edit" class="btn btn-primary-custom w-100">
                            <i class="bi bi-pencil-square me-1"></i> Edit Profile
                        </a>
                    </div>
                    <div class="col-6">
                        <a asp-action="ChangePassword" class="btn btn-outline-secondary w-100 fw-bold shadow-sm" style="border-radius: 8px;">
                            <i class="bi bi-shield-lock me-1"></i> Password
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    /* لمسات إضافية خاصة بصفحة البروفايل فقط */
    .icon-box {
        width: 50px;
        height: 50px;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.3s ease;
    }

    .custom-card:hover .icon-box {
        background-color: var(--primary-blue) !important;
        color: white !important;
        transform: scale(1.1);
    }

    .profile-details span {
        font-size: 1.1rem;
    }
</style>