@model Bus_Booking_System.ViewModel.ProfileDetailsVM

@{
    ViewData["Title"] = "My Profile";
}

<h2>My Profile</h2>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">
        @TempData["SuccessMessage"]
    </div>
}

<div class="card p-4">
    <div class="mb-3">
        <strong>Full Name:</strong>
        @if (Model.FullName == null || Model.FullName == "")
        {
            <span>Not Added</span>
        }
        else
        {
            <span>@Model.FullName</span>
        }
    </div>

    <div class="mb-3">
        <strong>User Name:</strong> @Model.UserName
    </div>

    <div class="mb-3">
        <strong>Email:</strong> @Model.Email
    </div>

    <div class="mb-3">
        <strong>Phone:</strong> @Model.Phone
    </div>

    <a asp-action="Edit" class="btn btn-primary">Edit Profile</a>
    <a asp-action="ChangePassword" class="btn btn-secondary">Change Password</a>
</div>
