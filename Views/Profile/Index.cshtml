@model Bus_Booking_System.ViewModel.ProfileDetailsVM

@{
    ViewData["Title"] = "My Profile";
}

<style>
    :root {
        --primary-blue: #0d6efd;
        --soft-bg: #f8fafc;
        --dark-navy: #1e293b;
    }

    .profile-card {
        background: #ffffff;
        border-radius: 30px;
        border: none;
        overflow: hidden;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.05);
    }

    .profile-header {
        background: linear-gradient(135deg, #f8fafc 0%, #e2e8f0 100%);
        padding: 40px 20px;
        text-align: center;
        border-bottom: 1px solid #f1f5f9;
    }

    .avatar-wrapper {
        width: 100px;
        height: 100px;
        background: white;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 15px;
        box-shadow: 0 8px 15px rgba(0,0,0,0.08);
        color: var(--primary-blue);
        border: 4px solid #fff;
    }

    .info-row {
        padding: 15px;
        border-radius: 15px;
        transition: all 0.3s ease;
        border: 1px solid transparent;
        margin-bottom: 10px;
    }

        .info-row:hover {
            background: #f8fafc;
            border-color: #e2e8f0;
        }

    .icon-square {
        width: 45px;
        height: 45px;
        background: #eff6ff;
        color: var(--primary-blue);
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.2rem;
    }

    .btn-edit-profile {
        background: var(--dark-navy);
        color: white;
        border-radius: 12px;
        padding: 12px;
        font-weight: 600;
        transition: all 0.3s;
    }

        .btn-edit-profile:hover {
            background: #000;
            transform: translateY(-2px);
            color: white;
        }

    .btn-password {
        border-radius: 12px;
        padding: 12px;
        font-weight: 600;
        border: 2px solid #e2e8f0;
        color: #64748b;
    }

        .btn-password:hover {
            background: #f1f5f9;
            color: var(--dark-navy);
        }

    .label-text {
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 1px;
        font-weight: 700;
        color: #94a3b8;
    }
</style>

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-5">

            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm mb-4" role="alert" style="border-radius: 15px; background-color: #dcfce7; color: #166534;">
                    <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            <div class="card profile-card">
                <div class="profile-header">
                    <div class="avatar-wrapper">
                        <i class="bi bi-person-fill display-4"></i>
                    </div>
                    <h4 class="fw-bold mb-1" style="color: var(--dark-navy);">Account Settings</h4>
                    <p class="text-muted small mb-0">Update your presence on Bus Booking</p>
                </div>

                <div class="card-body p-4 p-md-5">

                    <div class="info-row d-flex align-items-center">
                        <div class="icon-square me-3">
                            <i class="bi bi-person-vcard"></i>
                        </div>
                        <div>
                            <div class="label-text">Full Name</div>
                            <div class="fw-bold text-dark">@(string.IsNullOrEmpty(Model.FullName) ? "Not Provided" : Model.FullName)</div>
                        </div>
                    </div>

                    <div class="info-row d-flex align-items-center">
                        <div class="icon-square me-3">
                            <i class="bi bi-at"></i>
                        </div>
                        <div>
                            <div class="label-text">Username</div>
                            <div class="fw-bold text-dark">@Model.UserName</div>
                        </div>
                    </div>

                    <div class="info-row d-flex align-items-center">
                        <div class="icon-square me-3">
                            <i class="bi bi-envelope-at"></i>
                        </div>
                        <div>
                            <div class="label-text">Email Address</div>
                            <div class="fw-bold text-dark">@Model.Email</div>
                        </div>
                    </div>

                    <div class="info-row d-flex align-items-center">
                        <div class="icon-square me-3">
                            <i class="bi bi-phone"></i>
                        </div>
                        <div>
                            <div class="label-text">Phone Number</div>
                            <div class="fw-bold text-dark">@(string.IsNullOrEmpty(Model.Phone) ? "Not Linked" : Model.Phone)</div>
                        </div>
                    </div>

                    <div class="row mt-5 g-3">
                        <div class="col-12 col-sm-6">
                            <a asp-action="Edit" class="btn btn-edit-profile w-100 shadow-sm">
                                <i class="bi bi-pencil-square me-2"></i>Edit Profile
                            </a>
                        </div>
                        <div class="col-12 col-sm-6">
                            <a asp-action="ChangePassword" class="btn btn-password w-100 shadow-sm">
                                <i class="bi bi-shield-lock me-2"></i>Security
                            </a>
                        </div>
                    </div>

                </div>
            </div>

            <div class="text-center mt-4">
                <a asp-controller="Home" asp-action="Index" class="text-decoration-none text-muted small">
                    <i class="bi bi-arrow-left me-1"></i> Back to Home
                </a>
            </div>

        </div>
    </div>
</div>