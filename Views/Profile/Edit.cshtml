@model Bus_Booking_System.ViewModel.EditProfileVM

@{
    ViewData["Title"] = "Edit Profile";
}

<div class="d-flex justify-content-center align-items-center my-5">
    <div class="custom-card w-100" style="max-width: 500px;">
        <h3 class="fw-bold mb-4 text-center" style="color: var(--dark-blue);">Edit Profile</h3>

        <form asp-action="Edit" method="post">
            <div asp-validation-summary="All" class="text-danger small mb-3"></div>

            <div class="mb-3">
                <label asp-for="FullName" class="form-label text-muted small fw-bold"></label>
                <input asp-for="FullName" class="form-control" />
                <span asp-validation-for="FullName" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="UserName" class="form-label text-muted small fw-bold"></label>
                <input asp-for="UserName" class="form-control" />
                <span asp-validation-for="UserName" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Email" class="form-label text-muted small fw-bold"></label>
                <input asp-for="Email" class="form-control" />
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>

            <div class="mb-4">
                <label asp-for="Phone" class="form-label text-muted small fw-bold"></label>
                <input asp-for="Phone" class="form-control" />
                <span asp-validation-for="Phone" class="text-danger small"></span>
            </div>

            <div class="d-grid gap-2">
                <button type="submit" class="btn btn-primary-custom text-white">Save Changes</button>
                <a asp-action="Index" class="btn btn-light text-muted">Cancel</a>
            </div>
        </form>
    </div>
</div>