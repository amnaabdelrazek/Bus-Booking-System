<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Admin Panel</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

    <style>
        :root {
            --sidebar-bg: #0f172a;
            --sidebar-hover: #1e293b;
            --accent-blue: #3b82f6;
            --body-bg: #f1f5f9;
            --nav-width: 280px;
        }

        body {
            font-family: 'Inter', 'Segoe UI', sans-serif;
            background-color: var(--body-bg);
            margin: 0;
            display: flex;
            height: 100vh; 
            overflow: hidden; 
        }

        .sidebar {
            width: var(--nav-width);
            background-color: var(--sidebar-bg);
            color: white;
            display: flex;
            flex-direction: column;
            flex-shrink: 0;
            box-shadow: 4px 0 10px rgba(0,0,0,0.05);
            z-index: 1000;
        }

        .sidebar-header {
            padding: 1.5rem;
        }

        .sidebar-nav-container {
            flex-grow: 1;
            overflow-y: auto; /* السماح بالسكرول داخل المنيو فقط */
            padding-bottom: 1rem;
        }

            /* Hide scrollbar for Chrome, Safari and Opera */
            .sidebar-nav-container::-webkit-scrollbar {
                display: none;
            }

        .sidebar .nav-link {
            color: #94a3b8;
            padding: 12px 20px;
            border-radius: 12px;
            margin: 4px 15px;
            display: flex;
            align-items: center;
            font-weight: 500;
            transition: all 0.2s;
        }

            .sidebar .nav-link i {
                font-size: 1.2rem;
                margin-right: 12px;
            }

            .sidebar .nav-link:hover {
                background-color: var(--sidebar-hover);
                color: white;
                transform: translateX(5px);
            }

            .sidebar .nav-link.active {
                background-color: var(--accent-blue);
                color: white;
                box-shadow: 0 4px 12px rgba(59, 130, 246, 0.3);
            }

        .sidebar-footer {
            padding: 1.5rem;
            border-top: 1px solid rgba(255,255,255,0.1);
            background-color: var(--sidebar-bg);
        }

        .btn-public-site {
            background: rgba(255,255,255,0.05);
            border: 1px solid rgba(255,255,255,0.2);
            color: #fff;
            padding: 10px;
            border-radius: 10px;
            text-decoration: none;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: 0.3s;
            font-size: 0.9rem;
        }

            .btn-public-site:hover {
                background: var(--accent-blue);
                color: white;
                border-color: var(--accent-blue);
            }

        .main-wrapper {
            flex-grow: 1;
            display: flex;
            flex-direction: column;
            overflow: hidden; 
        }

        .admin-navbar {
            background-color: rgba(255, 255, 255, 0.8);
            backdrop-filter: blur(10px);
            border-bottom: 1px solid #e2e8f0;
            padding: 0.8rem 2rem;
        }

        .main-content {
            flex-grow: 1;
            overflow-y: auto; 
            padding: 2rem;
        }

        .user-profile-img {
            width: 35px;
            height: 35px;
            border-radius: 50%;
            background: var(--accent-blue);
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-weight: bold;
        }

    </style>
</head>
<body>

    <div class="sidebar">
        <div class="sidebar-header">
            <h4 class="text-white mb-0 fw-bold d-flex align-items-center">
                <span class="bg-primary p-2 rounded-3 me-2">
                    <i class="bi bi-bus-front-fill text-white"></i>
                </span>
                BusAdmin
            </h4>
        </div>

        <div class="sidebar-nav-container">
            <nav class="nav flex-column">
                <a class="nav-link @(ViewContext.RouteData.Values["Action"]?.ToString() == "Index" && ViewContext.RouteData.Values["Controller"]?.ToString() == "Admin" ? "active" : "")"
                   asp-controller="Admin" asp-action="Index">
                    <i class="bi bi-grid-1x2-fill"></i> Dashboard
                </a>

                <div class="px-4 mt-4 mb-2 text-uppercase fw-bold text-muted" style="font-size: 0.7rem; letter-spacing: 1px;">Management</div>

                <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "AdminCities" ? "active" : "")" asp-controller="AdminCities" asp-action="Index">
                    <i class="bi bi-building"></i> Cities
                </a>
                <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "AdminBuses" ? "active" : "")" asp-controller="AdminBuses" asp-action="Index">
                    <i class="bi bi-truck"></i> Buses Fleet
                </a>
                <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "AdminRoutes" ? "active" : "")" asp-controller="AdminRoutes" asp-action="Index">
                    <i class="bi bi-signpost-2"></i> Routes
                </a>
                <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "AdminTrips" ? "active" : "")" asp-controller="AdminTrips" asp-action="Index">
                    <i class="bi bi-calendar3"></i> Trips Schedule
                </a>
                <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "AdminBookings" ? "active" : "")" asp-controller="AdminBookings" asp-action="Index">
                    <i class="bi bi-ticket-perforated"></i> Bookings
                </a>
            </nav>
        </div>

        <div class="sidebar-footer">
            <a class="btn-public-site" asp-controller="Home" asp-action="Index">
                <i class="bi bi-arrow-left-circle me-2"></i>
                <span>Public Site</span>
            </a>
        </div>
    </div>

    <div class="main-wrapper">
        <header class="navbar admin-navbar sticky-top">
            <div class="container-fluid d-flex justify-content-between align-items-center">
                <div class="d-flex align-items-center">
                    <h5 class="mb-0 fw-bold text-dark">@ViewData["Title"]</h5>
                    <a asp-controller="Home" asp-action="Index" class="btn btn-sm btn-link text-muted ms-3 d-none d-md-inline-block shadow-none border-0">
                        <i class="bi bi-eye me-1"></i> Quick Preview
                    </a>
                </div>

                <div class="d-flex align-items-center">
                    <div class="dropdown">
                        <div class="d-flex align-items-center cursor-pointer" id="userMenu" data-bs-toggle="dropdown" style="cursor: pointer;">
                            <span class="me-3 d-none d-md-block fw-semibold text-muted">Administrator</span>
                            <div class="user-profile-img">A</div>
                        </div>
                        <ul class="dropdown-menu dropdown-menu-end shadow border-0 mt-3" aria-labelledby="userMenu">
                            <li>
                                <form asp-controller="Account" asp-action="Logout" method="post">
                                    <button type="submit" class="dropdown-item text-danger d-flex align-items-center">
                                        <i class="bi bi-box-arrow-right me-2"></i> Logout
                                    </button>
                                </form>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
        </header>

        <main class="main-content">
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>