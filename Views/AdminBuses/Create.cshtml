@model Bus_Booking_System.Models.Bus
@{
    ViewData["Title"] = "Add New Bus";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="card border-0 shadow-sm rounded-3" style="max-width: 600px;">
    <div class="card-header bg-white border-bottom-0 pt-4 pb-0">
        <h4 class="fw-bold text-muted">Add Bus Details</h4>
    </div>
    <div class="card-body p-4">
        <form asp-action="Create">
            <div class="mb-3">
                <label asp-for="BusNum" class="form-label fw-bold">Bus Plate Number</label>
                <input asp-for="BusNum" class="form-control" placeholder="e.g. ABC-1234" />
                <span asp-validation-for="BusNum" class="text-danger small"></span>
            </div>

            <div class="row mb-4">
                <div class="col-md-6">
                    <label asp-for="TotalSeats" class="form-label fw-bold">Total Seats</label>
                    <input asp-for="TotalSeats" class="form-control" type="number" min="10" />
                    <span asp-validation-for="TotalSeats" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Type" class="form-label fw-bold">Bus Type</label>
                    <select asp-for="Type" class="form-select">
                        <option value="">Select Type...</option>
                        <option value="Economy">Economy</option>
                        <option value="VIP">VIP</option>
                        <option value="Sleeper">Sleeper</option>
                    </select>
                    <span asp-validation-for="Type" class="text-danger small"></span>
                </div>
            </div>

            <div class="d-flex justify-content-between">
                <a asp-action="Index" class="btn btn-light">Cancel</a>
                <button type="submit" class="btn btn-primary">Save Bus</button>
            </div>
        </form>
    </div>
</div>