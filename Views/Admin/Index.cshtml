@{
    ViewData["Title"] = "Dashboard";
    Layout = "~/Views/Shared/_AdminLayout.cshtml"; 
}

<div class="row g-4">
    <div class="col-md-3">
        <div class="card border-0 shadow-sm rounded-3">
            <div class="card-body text-center py-4">
                <i class="bi bi-ticket-detailed display-4 text-primary mb-2"></i>
                <h5 class="text-muted">Active Bookings</h5>
                <h2 class="fw-bold" id="totalBookings">@ViewBag.TotalBookings</h2>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card border-0 shadow-sm rounded-3">
            <div class="card-body text-center py-4">
                <i class="bi bi-calendar-event display-4 text-success mb-2"></i>
                <h5 class="text-muted">Active Trips</h5>
                <h2 class="fw-bold" id="activeTrips">@ViewBag.ActiveTrips</h2>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card border-0 shadow-sm rounded-3">
            <div class="card-body text-center py-4">
                <i class="bi bi-truck display-4 text-warning mb-2"></i>
                <h5 class="text-muted">Total Buses</h5>
                <h2 class="fw-bold" id="totalBuses">@ViewBag.TotalBuses</h2>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card border-0 shadow-sm rounded-3">
            <div class="card-body text-center py-4">
                <i class="bi bi-people display-4 text-danger mb-2"></i>
                <h5 class="text-muted">Total Users</h5>
                <h2 class="fw-bold" id="totalUsers">@ViewBag.TotalUsers</h2>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/6.0.1/signalr.min.js"></script>

    <script>
        var connection = new signalR.HubConnectionBuilder().withUrl("/dashboardHub").build();

        connection.on("ReceiveStatsUpdate", function () {
            loadDashboardStats();
        });

        function loadDashboardStats() {
            fetch('/Admin/GetDashboardStats')
                .then(response => response.json())
                .then(data => {
                    document.getElementById("totalBuses").innerText = data.buses;
                    document.getElementById("activeTrips").innerText = data.trips;
                    document.getElementById("totalUsers").innerText = data.users;
                    document.getElementById("totalBookings").innerText = data.bookings;

                    highlightChange("totalBookings");
                    highlightChange("activeTrips");
                    highlightChange("totalBuses");
                    highlightChange("totalUsers");
                })
                .catch(error => console.error('Error fetching new stats:', error));
        }

        connection.start().then(function () {
            console.log("🟢 SignalR Ready! Waiting for updates from other browsers...");
        }).catch(function (error) {
            console.error("SignalR connection error:", error);
        });

        function highlightChange(elementId) {
            var el = document.getElementById(elementId);
            if(el) {
                el.style.transition = "color 0.4s ease-in-out";
                el.style.color = "#198754";
                setTimeout(function () {
                    el.style.color = "";
                }, 800);
            }
        }
    </script>
}
