@using Bus_Booking_System.ViewModel
@model List<TripResultViewModel>

@{
    ViewData["Title"] = "Search Results";
}

<style>
    
    .trip-card {
        background: #ffffff;
        border-radius: 20px;
        border: 1px solid #e2e8f0;
        transition: all 0.3s ease;
        position: relative;
        overflow: hidden;
    }

        .trip-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 12px 24px rgba(0, 0, 0, 0.08);
            border-color: var(--primary-blue);
        }

    .trip-header {
        background-color: #f8fafc;
        padding: 12px 20px;
        border-bottom: 1px dashed #e2e8f0;
    }

    .price-tag {
        color: var(--primary-blue);
        font-size: 1.25rem;
        font-weight: 800;
    }

    .bus-info {
        font-size: 0.8rem;
        text-transform: uppercase;
        letter-spacing: 1px;
        color: #64748b;
        font-weight: 700;
    }

    .route-line {
        position: relative;
        height: 2px;
        background: #e2e8f0;
        width: 100%;
        margin: 0 15px;
    }

        /* .route-line::after { */
        /*     content: '\F21A'; */
        /*     font-family: "bootstrap-icons"; */
        /*     position: absolute; */
        /*     top: -12px; */
        /*     left: 50%; */
        /*     transform: translateX(-50%); */
        /*     background: white; */
        /*     padding: 0 8px; */
        /*     color: var(--primary-blue); */
        /*     font-size: 1.1rem; */
        /* } */

    .time-display {
        font-size: 1.1rem;
        font-weight: 700;
        color: #1e293b;
    }

    .city-name {
        font-weight: 600;
        color: #64748b;
    }

    .btn-select-seats {
        background-color: var(--primary-blue);
        color: white;
        border-radius: 12px;
        padding: 10px;
        font-weight: 600;
        border: none;
        transition: 0.3s;
    }

        .btn-select-seats:hover {
            background-color: var(--dark-blue);
            color: white;
        }

    .no-results-card {
        background: white;
        border-radius: 24px;
        padding: 60px 20px;
        border: none;
        box-shadow: 0 10px 30px rgba(0,0,0,0.05);
    }
</style>

<div class="container py-5">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-5">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-2">
                    <li class="breadcrumb-item"><a asp-action="Index" class="text-decoration-none">Search</a></li>
                    <li class="breadcrumb-item active">Available Trips</li>
                </ol>
            </nav>
            <h2 class="fw-bold m-0 text-dark">We found <span class="text-primary">@Model.Count</span> trips for you</h2>
        </div>
        <a asp-action="Index" class="btn btn-outline-primary rounded-pill px-4 mt-3 mt-md-0 shadow-sm">
            <i class="bi bi-arrow-left me-2"></i> Modify Search
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="no-results-card text-center shadow-sm">
            <div class="mb-4">
                <i class="bi bi-bus-front text-muted opacity-25" style="font-size: 5rem;"></i>
            </div>
            <h3 class="fw-bold text-dark">No Trips Available</h3>
            <p class="text-muted mb-4">Sorry, we couldn't find any trips for the selected route or date.</p>
            <a asp-action="Index" class="btn btn-primary btn-lg rounded-pill px-5 shadow">
                Try Another Date
            </a>
        </div>
    }
    else
    {
        <div class="row">
            @foreach (var trip in Model)
            {
                <div class="col-md-6 col-lg-4 mb-4">
                    <div class="trip-card h-100 shadow-sm">
                        <div class="trip-header d-flex justify-content-between align-items-center">
                            <span class="bus-info">
                                <i class="bi bi-info-circle me-1"></i> Bus #@trip.BusNumber
                            </span>
                            <div class="price-tag">
                                @trip.Price <span style="font-size: 0.8rem;">EGP</span>
                            </div>
                        </div>

                        <div class="card-body p-4 text-center">
                            <div class="d-flex justify-content-between align-items-center mb-4">
                                <div class="flex-shrink-0">
                                    <div class="time-display">@trip.DepartureTime.ToString("hh:mm tt")</div>
                                    <div class="city-name small text-uppercase">@trip.From</div>
                                </div>

                                @* <div class="route-line"></div> *@

                                <div class="col-4">
                                    <div class="route-wrapper position-relative d-flex align-items-center justify-content-center" style="height: 40px;">
                                        <div class="route-line" style="margin: 0; width: 100%;"></div>

                                        <div class="bus-icon-wrap position-absolute bg-white px-2" style="left: 50%; transform: translateX(-50%);">
                                            <i class="bi bi-bus-front fs-5 text-primary"></i>
                                        </div>
                                    </div>
                                </div>

                                <div class="flex-shrink-0">
                                    <div class="time-display">@trip.ArrivalTime.ToString("hh:mm tt")</div>
                                    <div class="city-name small text-uppercase">@trip.To</div>
                                </div>
                            </div>

                            <div class="d-flex align-items-center justify-content-center mb-4 bg-light py-2 rounded-3">
                                <i class="bi bi-person-workspace text-primary me-2"></i>
                                <span class="small fw-bold text-muted">Available: <span class="text-dark">@trip.AvailableSeats Seats</span></span>
                            </div>

                            <a asp-controller="Trip" asp-action="ShowTrip" asp-route-id="@trip.TripId"
                               class="btn btn-dark rounded-pill px-4 py-2 fw-bold shadow-sm">
                                Book <i class="bi bi-arrow-right ms-1"></i>
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>