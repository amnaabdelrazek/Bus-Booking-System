@using Bus_Booking_System.ViewModel
@model List<TripResultViewModel>

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />

<div class="container mt-5">

    <h2>Available Trips</h2>

    <a asp-action="Index" class="btn btn-secondary mb-3">Back</a>

    @if (!Model.Any())
    {
        <div class="alert alert-warning">No trips found 😢</div>
    }
    else
    {
        <div class="row">

            @foreach (var trip in Model)
            {
                <div class="col-md-4 mb-4">

                    <div class="card shadow">

                        <div class="card-body">

                            <h5>@trip.From → @trip.To</h5>

                            <p>🕒 @trip.DepartureTime.ToString("hh:mm tt")</p>
                            <p>⏱ Arrival: @trip.ArrivalTime.ToString("hh:mm tt")</p>

                            <p>💰 Price: @trip.Price EGP</p>
                            <p>💺 Seats: @trip.AvailableSeats</p>

                            <p>🚌 Bus: @trip.BusNumber</p>

                            <a asp-controller="Booking"
                               asp-action="SelectSeats"
                               asp-route-tripId="@trip.TripId"
                               class="btn btn-primary w-100">
                                Book Now
                            </a>

                        </div>

                    </div>

                </div>
            }

        </div>
    }

</div>