@using Bus_Booking_System.ViewModel
@model SearchViewModel

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />

<section class="vh-100 d-flex align-items-center" style="background: linear-gradient(to right,#4facfe,#00f2fe);">
    <div class="container">

        <div class="row">
            <div class="col-md-6 text-white">
                <h1>Find Your Trip</h1>
                <p>Book bus tickets easily 🚍</p>
            </div>

            <div class="col-md-6">
                <div class="bg-white p-4 rounded shadow">

                    <form asp-action="Search" method="get">

                        <div class="mb-3">
                            <label>From</label>
                            <select asp-for="DepartureCityId" class="form-control"
                                    asp-items="@(new SelectList(Model.Cities,"Id","Name"))">
                                <option value="">Select City</option>
                            </select>
                        </div>

                        <div class="mb-3">
                            <label>To</label>
                            <select asp-for="ArrivalCityId" class="form-control"
                                    asp-items="@(new SelectList(Model.Cities,"Id","Name"))">
                                <option value="">Select City</option>
                            </select>
                        </div>

                        <div class="mb-3">
                            <label>Date</label>
                            <input asp-for="TravelDate" type="date" class="form-control" />
                        </div>

                        <button class="btn btn-primary w-100">Search</button>

                    </form>

                </div>
            </div>
        </div>

    </div>
</section>