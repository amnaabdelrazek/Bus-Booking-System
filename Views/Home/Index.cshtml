@using Bus_Booking_System.ViewModel
@model SearchViewModel

@{
    ViewData["Title"] = "Home Page";
}

<section class="d-flex align-items-center rounded-4 shadow-sm overflow-hidden mt-2" style="min-height: 80vh; background: linear-gradient(135deg, #0d2b4d 0%, #0056b3 100%);">
    <div class="container py-5">
        <div class="row align-items-center">

            <div class="col-md-6 text-white text-center text-md-start mb-5 mb-md-0">
                <h1 class="display-4 fw-bold mb-3">Find Your Trip <i class="bi bi-bus-front-fill"></i></h1>
                <p class="lead" style="color: #e8f0fe;">Book bus tickets easily, securely, and travel comfortably across the country.</p>
            </div>

            <div class="col-md-6">
                <div class="custom-card">
                    <h4 class="text-center fw-bold mb-4" style="color: var(--dark-blue);">Book Your Ticket</h4>
                    <form asp-action="Search" method="get">
                        <div class="mb-3">
                            <label class="form-label fw-bold text-muted small"><i class="bi bi-geo-alt"></i> From</label>
                            <select asp-for="DepartureCityId" class="form-select" asp-items="@(new SelectList(Model.Cities,"Id","Name"))">
                                <option value="">Select City</option>
                            </select>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold text-muted small"><i class="bi bi-pin-map"></i> To</label>
                            <select asp-for="ArrivalCityId" class="form-select" asp-items="@(new SelectList(Model.Cities,"Id","Name"))">
                                <option value="">Select City</option>
                            </select>
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-bold text-muted small"><i class="bi bi-calendar-event"></i> Travel Date</label>
                            <input asp-for="TravelDate" type="date" class="form-control"
                                   value="@DateTime.Now.ToString("yyyy-MM-dd")"
                                   min="@DateTime.Now.ToString("yyyy-MM-dd")" />
                        </div>

                        <button class="btn btn-primary-custom w-100 text-white shadow-sm">
                            <i class="bi bi-search me-2"></i> Search Trips
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>
